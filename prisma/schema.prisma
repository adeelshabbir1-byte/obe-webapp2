// ============================================================================
// OBE / Curriculum / Accreditation Platform — Core Data Model (MVP)
// Lineage backbone: Super User -> Chairman -> Program Coordinator -> Faculty
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_USER
  CHAIRMAN
  PROGRAM_COORDINATOR
  SUBJECT_EXPERT
  INSTRUCTOR
  OMC
  COURSE_ASSIGNER
  HEAD_OF_DEPARTMENT
  PROGRAM_LEAD
  DEAN
  DEPARTMENT_COORDINATOR
  LAB_ENGINEER
  LAB_MANAGER
  LIBRARIAN
  FINANCE_OFFICER
  STUDENT_AFFAIRS
  FACILITIES_MANAGER
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String   // Argon2id hash — never plaintext
  name               String
  role               UserRole
  department         String?

  // Self-relation: who created / manages this account (Super User -> Chairman ->
  // Program Coordinator -> Faculty). Keeps the org chain queryable without a
  // separate institution model, which can be layered in later.
  managedById        String?
  managedBy          User?    @relation("UserManagement", fields: [managedById], references: [id])
  managedUsers       User[]   @relation("UserManagement")
  aiConfig           AiConfig? @relation("AiConfigChairman")

  mustChangePassword Boolean  @default(false)
  mfaEnabled         Boolean  @default(false)
  mfaSecret          String?
  mfaBackupCodes     String?  // JSON array of hashed one-time backup codes
  instituteName      String? // set by Super User only, per-Chairman (this is a multi-tenant SaaS — each paying institution has its own)
  instituteLogo      String? @db.Text // base64 data URI, set by Super User only, per-Chairman
  normalLoad         Int      @default(3)  // standard course/lab-section load, set by Coordinator at onboarding
  specialization     String?  // e.g. "Software Engineering", "AI", "Networks" — set by Coordinator, used to suggest a good fit for elective/specialization courses
  minCreditsPerSemester Int?  // Coordinator's own institutional policy for the Degree Planner's load validation; null = a sensible built-in default is used instead
  maxCreditsPerSemester Int?
  customCategoryId   String?  // faculty's own institution-defined category (see CustomCategory) — separate from specialization, e.g. "Maths", "Management"
  customCategory     CustomCategory? @relation("FacultyCustomCategory", fields: [customCategoryId], references: [id])
  omcHat             Boolean  @default(false) // a faculty member who also sits on the Outcome Management Committee
  assignerTerm       String?  // Course Assigner hat given to a teacher: "Fall 2026" (that semester only) or "ALWAYS" (until removed)
  extraRoles         String[] @default([]) // roles beyond the main one and two hats, for a small university where one person holds many
  tertiaryRole       String?  // a third hat for someone who is, say, a Subject Expert AND teaches AND leads (Dean / Chairman / Program Lead)
  secondaryRole      String?  // set on a SUBJECT_EXPERT to also let them be assigned/act as an INSTRUCTOR (same account, same or different course) — a dual-capable person picks which one to act as at login
  maxDegreePrograms  Int?     // set by Super User on a CHAIRMAN account — the number of distinct Degree Programs their institution is licensed for; null = unlimited
  isAlumniCustodian  Boolean  @default(false) // set by Chairman on ONE faculty member — that person reviews/approves all alumni & employer data submitted by any faculty
  externalLoadCount  Int      @default(0)  // load from courses taught elsewhere (e.g. MS-level) not tracked in this system
  externalLoadNote   String?               // e.g. "2 courses at MS level"
  isActive           Boolean  @default(true)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  courses            Course[] @relation("CourseCoordinator")
  omcReviewAssignments Course[] @relation("CourseOmcReviewer")
  customCategories   CustomCategory[] @relation("CustomCategoryChairman")
  reviewedOutOfBatchRequests OutOfBatchRequest[] @relation("OutOfBatchRequestReviewer")
  advisedBatches     Batch[] @relation("BatchAdvisor")
  reviewedRegistrationApprovals RegistrationApprovalRequest[] @relation("RegistrationApprovalReviewer")
  reviewedAccountRequests AccountRequest[] @relation("AccountRequestReviewer")
  electiveGroups     ElectiveSlotGroup[] @relation("ElectiveGroupCoordinator")
  seCourses          Course[] @relation("CourseSubjectExpert")
  teachingCourses    Course[] @relation("CourseInstructor")
  sectionAssignments CourseSectionAssignment[] @relation("SectionInstructor")
  groupSectionAssignments GroupSectionAssignment[] @relation("GroupSectionInstructor")
  equivalenceGroups  CourseEquivalenceGroup[] @relation("EquivalenceChairman")
  plos               PLO[]    @relation("PloCoordinator")
  batches            Batch[]  @relation("BatchCoordinator")
  currentTerm        CurrentTerm? @relation("CurrentTermCoordinator")
  holidays           Holiday[]    @relation("HolidayCoordinator")
  classDayModes      ClassDayMode[] @relation("ClassDayModeCoordinator")
  cqiRecords         CqiRecord[]  @relation("CqiChairman")
  semesterDates      SemesterDates[] @relation("SemesterDatesCoordinator")
  gradingScale       GradingScale[]  @relation("GradingScaleCoordinator")
  reportAccessRules  ReportAccessRule[] @relation("ReportAccessChairman")
  programProfiles    ProgramProfile[] @relation("ProgramProfileCoordinator")
  alumni             Alumni[] @relation("AlumniChairman")
  degreePrograms     DegreeProgram[] @relation("DegreeProgramCoordinator")
  ownedRooms         Room[] @relation("RoomChairman")
  scheduleSections   ScheduleSection[] @relation("ScheduleSectionInstructor")
  facultyUnavailability FacultyUnavailability[] @relation("FacultyUnavailabilityFaculty")
  coursePreferences  FacultyCoursePreference[] @relation("FacultyCoursePreferenceFaculty")
  courseShortNames   CourseShortName[] @relation("CourseShortNameChairman")
  contentSyncGroups  CourseContentSyncGroup[] @relation("ContentSyncChairman")
  ownedMasterCurricula MasterCurriculum[] @relation("MasterCurriculumOwner")
  departmentId       String?  // home department (see Department) - coordinators, course assigners, heads and faculty each belong to one
  department_        Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  facultyId          String?  // DEAN only: the faculty (group of departments) this person leads
  faculty_           Faculty? @relation("FacultyDean", fields: [facultyId], references: [id])
  leadProgram        String?  // PROGRAM_LEAD only: the one degree program (e.g. "BS Computer Science") this person is responsible for
  isVisitingPlaceholder Boolean @default(false) // the built-in "Visiting Faculty (to be decided)" stand-in - not a real person, never logs in
  preferredDays      String?  // comma list e.g. "Mon,Wed" — instructor's preferred teaching days (soft preference for the timetable)
  canTeach           Boolean  @default(true) // false for an outside (industry / other-institute) Subject Expert who designs courses but is never assigned to teach
  organization       String?  // for a guest / industry Subject Expert: the company or institute they come from (shown beside their public courses)
  isPlatformExpert   Boolean  @default(false) // a Subject Expert created by the platform admin, attached to no institute, who designs Master Curriculum courses for everyone
  publicCourses      PublicCourse[] @relation("PublicCourseAuthor")
  designedMasterCourses MasterCourse[] @relation("MasterCourseDesigner")
  curriculumAssignments CurriculumAssignment[] @relation("CurriculumAssignmentChairman")
  departmentsOwned      Department[] @relation("DepartmentChairman")
  facultiesOwned        Faculty[]    @relation("FacultyInstitute")
  courseLeadOf          CourseLead[] @relation("CourseLeadUser")
  labCourses            Course[]     @relation("CourseLabEngineer")
  teacherLoans          TeacherLoanRequest[] @relation("LoanInstructor")
  loanAllowances        TeacherLoanAllowed[] @relation("LoanAllowedInstructor")
  timetableRuns      TimetableRun[] @relation("TimetableRunChairman")
  employers          Employer[] @relation("EmployerChairman")
  surveyTemplates    SurveyTemplate[] @relation("SurveyTemplateCoordinator")
  weightPolicies     WeightPolicy[] @relation("WeightPolicyChairman")
  passingCriteriaVersions PassingCriteria[] @relation("PassingCriteriaChairman")
  auditLogs          AuditLog[]

  @@index([managedById])
  @@index([customCategoryId])
  @@index([departmentId])
  @@index([facultyId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  mfaVerified Boolean @default(true) // false only while an MFA-enabled user's login is pending code entry
  actingForId String? // DEPARTMENT_COORDINATOR only: which program lead's data they are working on right now
  activeRole  String? // which role a dual-capable person (Subject Expert who can also Instruct) chose for this session

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([userId])
}

// A degree program the Coordinator's institution offers (e.g. "BS Computer
// Science") — set up once, then reused every semester to quickly create
// that term's intake batches via checkboxes rather than retyping names.
model DegreeProgram {
  id             String  @id @default(cuid())
  coordinatorId  String
  coordinator    User    @relation("DegreeProgramCoordinator", fields: [coordinatorId], references: [id])
  name           String  // e.g. "BS Computer Science" — matches Batch.degreeProgram for compatibility with existing reports/licensing
  shortCode      String  // e.g. "BSCS" — used to auto-generate batch names
  defaultIntakeSize Int  @default(30)
  usuallyOfferedInFall   Boolean @default(true)
  usuallyOfferedInSpring Boolean @default(false)
  createdAt      DateTime @default(now())

  @@unique([coordinatorId, shortCode])
  @@index([coordinatorId])
}

// A cohort/intake — e.g. "BS Computer Science, Fall 2025". Different batches
// can follow different schemes of studies, so the same HEC curriculum can be
// (re-)imported independently for each one.
model Batch {
  id             String   @id @default(cuid())
  coordinatorId  String
  coordinator    User     @relation("BatchCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram  String   // e.g. "BS Computer Science"
  batchName      String   // e.g. "Fall 2025"
  startTerm      String   @default("Fall")   // "Fall" | "Spring" — which term this batch's Semester 1 falls in
  startYear      Int      @default(2025)
  studentCount   Int      @default(0) // current active student count — editable each semester as students join/leave
  registrationOpen Boolean @default(false) // Coordinator toggle: whether students in this batch can self-register/withdraw for the current term right now
  advisorId      String?  // the faculty member designated to mentor/approve registration for this batch's students
  advisor        User?    @relation("BatchAdvisor", fields: [advisorId], references: [id])
  prerequisitesConfirmedAt DateTime? // set once the Coordinator has reviewed/set up this batch's Prerequisite Map — required before courses can be offered
  createdAt      DateTime @default(now())

  courses        Course[]
  plos           PLO[]    @relation("BatchPlos")
  cqiRecords     CqiRecord[]
  students       Student[]
  scheduleConfig BatchScheduleConfig?
  electiveGroups ElectiveSlotGroup[]

  @@unique([coordinatorId, degreeProgram, batchName])
  @@index([coordinatorId])
  @@index([advisorId])
}

// The single "what term is it right now" setting per coordinator/program —
// updating this drives which batch is in which semester automatically.
model CurrentTerm {
  id            String   @id @default(cuid())
  coordinatorId String   @unique
  coordinator   User     @relation("CurrentTermCoordinator", fields: [coordinatorId], references: [id])
  termName      String   // "Fall" | "Spring"
  year          Int
  updatedAt     DateTime @updatedAt
}

// OMC-defined institution-wide pass/fail threshold for CLO and PLO
// attainment — how much of a CLO/PLO's max weighted marks a student needs
// to count as having "passed" it. Defaults to 50% for both if never set.
// Per-lecture attendance, marked by the Instructor for each enrolled
// student. One record per (lecture, student) — status can be updated by
// re-marking, not accumulated.
model AttendanceRecord {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  lectureRowId String
  lectureRow   LectureRow @relation(fields: [lectureRowId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  status       String   // "PRESENT" | "LATE" | "ABSENT" | "LEAVE" (LEAVE = excused)
  markedById   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([lectureRowId, studentId])
  @@index([courseId])
  @@index([studentId])
}

// Institution-wide minimum attendance % — below this, a student is
// flagged in the attendance report. Defaults to 75% if never set.
model AttendanceThreshold {
  id            String @id @default(cuid())
  chairmanId    String @unique
  minPercentage Int    @default(75)
  // How the percentage is worked out, and the defaults of a QR attendance session (set by the OMC).
  lateCountsPresent Boolean @default(true)
  excusedExcluded   Boolean @default(false)
  warnMarginPct     Int     @default(5)
  qrPresentMinutes  Int     @default(10)
  qrLateMinutes     Int     @default(25)
  qrRotateSeconds   Int     @default(12)
}

// ===== Timetable Module =====
// A room or lab, shared across the whole institution's timetable.
model Room {
  id         String @id @default(cuid())
  chairmanId String
  chairman   User   @relation("RoomChairman", fields: [chairmanId], references: [id])
  name       String // e.g. "Room 204", "AI Lab"
  type       String // "LECTURE" | "LAB"
  capacity   Int
  departmentId String? // null = common room; otherwise owned by that department
  department   Department? @relation("RoomDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  timetableEntries TimetableEntry[]
  @@unique([chairmanId, name])
  @@index([chairmanId])
  @@index([departmentId])
}

// One schedulable teaching unit — a course taught by one instructor to one
// section of students. PC sets how many sessions/week it needs, how long
// each is, and what kind of room. Auto-generated from Course +
// CourseSectionAssignment data, with PC free to add more or edit.

model ScheduleSection {
  id             String   @id @default(cuid())
  // Exactly one of courseId/groupId is set, never both — a section either
  // belongs to one standalone course, or to a Course Equivalence Group's
  // combined class (multiple batches' equivalent courses taught together).
  // Both nullable rather than a discriminated union because Prisma has no
  // native way to enforce "exactly one" at the schema level; app code is
  // responsible for that invariant (see schedule-sections/auto-generate).
  courseId       String?
  course         Course?  @relation(fields: [courseId], references: [id])
  groupId        String?
  group          CourseEquivalenceGroup? @relation(fields: [groupId], references: [id])
  instructorId   String
  instructor     User     @relation("ScheduleSectionInstructor", fields: [instructorId], references: [id])
  sectionLabel   String   @default("Section A")
  sessionsPerWeek Int     @default(2) // theory default: 2 sessions/week (lab default: 1) — see ScheduleSection auto-generation
  sessionDurationMinutes Int @default(90) // theory default: 1.5hr (lab default: 3hr)
  roomTypeNeeded String   @default("LECTURE") // "LECTURE" | "LAB"
  createdAt      DateTime @default(now())

  timetableEntries TimetableEntry[]
  @@index([courseId])
  @@index([groupId])
  @@index([instructorId])
}

// Per-batch scheduling window — PC sets which days and hours that batch's
// classes can be scheduled within.
model BatchScheduleConfig {
  id             String @id @default(cuid())
  batchId        String @unique
  batch          Batch  @relation(fields: [batchId], references: [id])
  workingDaysJson String @default("[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]")
  dailyStartHour Int    @default(8)
  dailyEndHour   Int    @default(16)
}

// A blocked time window for one faculty member — set by the PC on their
// behalf, or by the faculty member themselves. The scheduler treats every
// row here as a hard constraint never to schedule into.
model FacultyUnavailability {
  id           String @id @default(cuid())
  facultyId    String
  faculty      User   @relation("FacultyUnavailabilityFaculty", fields: [facultyId], references: [id])
  dayOfWeek    String // "Mon".."Sun"
  startHour    Float  // hours, half-hours allowed (8.5 = 8:30); the database column is double precision
  endHour      Float
  setById      String
  note         String?
  createdAt    DateTime @default(now())

  @@index([facultyId])
}

// One generated timetable — kept so a Coordinator can regenerate and
// compare, rather than only ever having one live version.
model TimetableRun {
  id           String   @id @default(cuid())
  chairmanId   String
  chairman     User     @relation("TimetableRunChairman", fields: [chairmanId], references: [id])
  generatedById String
  status       String   @default("RUNNING") // "RUNNING" | "COMPLETED" | "STOPPED" | "FAILED"
  scopeKey     String? // "SHARED" (the common timetable) or a department id (that department's own timetable)
  fitnessScore Float?
  hardViolations Int?
  generations  Int?
  notes        String?  @db.Text
  bestChromosomeJson String? @db.Text // serialized best-so-far chromosome — lets the next chunk resume rather than restart from scratch
  targetEndTime DateTime? // when this run should stop even if not perfect (e.g. now + 30 min)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries TimetableEntry[]
  @@index([chairmanId])
}

// One (day, time, room) assignment for one schedule section, within one
// generated run.
model TimetableEntry {
  id                String          @id @default(cuid())
  timetableRunId    String
  timetableRun      TimetableRun    @relation(fields: [timetableRunId], references: [id])
  scheduleSectionId String
  scheduleSection   ScheduleSection @relation(fields: [scheduleSectionId], references: [id])
  roomId            String
  room              Room            @relation(fields: [roomId], references: [id])
  dayOfWeek         String
  startHour         Float
  endHour           Float

  @@index([timetableRunId])
  @@index([scheduleSectionId])
  @@index([roomId])
}

// Versioned like GradingScale: a new row with a later effectiveFrom
// term/year supersedes the old one going forward, without losing the
// old value for batches/terms it still applies to — CLO/PLO passing
// thresholds can legitimately change from one semester to the next
// (e.g. tightening PLO attainment expectations), and reports run
// against an older term need the criteria that were actually in force
// then, not today's.
model PassingCriteria {
  id            String @id @default(cuid())
  chairmanId    String
  chairman      User   @relation("PassingCriteriaChairman", fields: [chairmanId], references: [id])
  cloPassingPct Int    @default(50)
  ploPassingPct Int    @default(50)
  deficiencyPassingPct Int @default(40) // pass mark for non-credit deficiency courses (e.g. Maths-I/II for pre-medical entrants)
  effectiveFromTerm String @default("Fall") // this version applies to terms on/after this point
  effectiveFromYear Int    @default(2000) // low default so pre-existing rows keep applying to every already-created term

  @@unique([chairmanId, effectiveFromTerm, effectiveFromYear])
  @@index([chairmanId])
}

// OMC-defined min/max assessment weight ranges per course type. A Subject
// Expert's weights must fall within these; if not, a WeightExceptionRequest
// is created instead of saving directly.
model WeightPolicy {
  id            String   @id @default(cuid())
  chairmanId    String
  chairman      User     @relation("WeightPolicyChairman", fields: [chairmanId], references: [id])
  updatedById   String?  // which OMC member last changed this policy
  courseType    String   // Core | Elective | Lab | IDS | General Education | Capstone Project | Field Experience
  assignmentMin Int      @default(0)
  assignmentMax Int      @default(100)
  assignmentMinCount Int @default(1) // minimum number of assignments to be conducted
  quizMin       Int      @default(0)
  quizMax       Int      @default(100)
  quizMinCount  Int      @default(1) // minimum number of quizzes to be conducted
  projectMin    Int      @default(0)
  projectMax    Int      @default(100)
  projectMinCount Int    @default(0)
  labMin        Int      @default(0)
  labMax        Int      @default(100)
  labMinCount   Int      @default(0)
  midtermMin    Int      @default(0)
  midtermMax    Int      @default(100)
  midtermMinCount Int    @default(1)
  finalMin      Int      @default(0)
  finalMax      Int      @default(100)
  finalMinCount Int      @default(1)
  finalBeforeMidtermPct Int? // OMC guidance: share (%) of the Final paper that should come from topics taught up to the midterm; null = no guidance
  ploMinPct     Int      @default(0)  // every PLO a course serves must carry at least this % of the course marks (0 = no rule)
  ploMinItems   Int      @default(0)  // ...and be tested by at least this many assessment items (quizzes, assignments, exam papers)
  cloSpreadMax  Int      @default(7)  // largest allowed gap (% of marks) between the most and least assessed CLO
  cloMinTopics  Int      @default(3)  // every CLO needs at least this many lecture topics in the plan (0 = no rule)
  ploMinTopics  Int      @default(0)  // every PLO a course serves needs at least this many lecture topics in the plan (0 = no rule)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chairmanId, courseType])
  @@index([chairmanId])
}

// A Subject Expert's proposed weights that fall outside the policy range,
// pending OMC approval. Only the latest request per course is kept.
model WeightExceptionRequest {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  source        String   @default("SE") // "SE" | "INSTRUCTOR" — which one's proposed weights this is
  requestedById String
  assignmentPct Int
  quizPct       Int
  projectPct    Int
  labPct        Int
  midtermPct    Int
  finalPct      Int
  status        String   @default("pending") // pending | approved | rejected
  omcComment    String?  @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([courseId, source])
  @@index([courseId])
}

// Which faculty member teaches how many sections of a given (offered)
// course — the source of truth for the Course Assigner's load matrix.
// A single course can have multiple rows (split across faculty by section).
model CourseSectionAssignment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  instructorId String
  instructor   User     @relation("SectionInstructor", fields: [instructorId], references: [id])
  sectionCount Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([courseId, instructorId])
  @@index([courseId])
  @@index([instructorId])
}

// OMC-defined equivalence: courses that are the same underlying content
// across different batches/programs (even with different codes/names) and
// can be taught together as one combined class, split into sections once
// combined enrollment crosses the 50-student cap.
// A separate, independent link from Course Equivalence — pairing two or
// more courses here does NOT combine their teaching/sections. It ONLY
// means: whenever a Subject Expert saves a content change (CLOs, PLO
// mappings, weekly lecture plan, assessment instruments, textbook/
// description fields) on any member, that same content is automatically
// copied onto every OTHER member of the group, replacing what they had.
model CourseContentSyncGroup {
  id         String   @id @default(cuid())
  chairmanId String
  chairman   User     @relation("ContentSyncChairman", fields: [chairmanId], references: [id])
  createdById String?
  name       String
  createdAt  DateTime @default(now())
  // Linking courses together no longer copies content immediately — that
  // was the actual source of "Accept All takes hours": every link
  // triggered a full content copy right then. A group is marked as
  // needing a sync whenever its membership or base changes, and only
  // the explicit "Sync All Content" action actually performs the copy,
  // once, for everything pending at once.
  needsSync  Boolean  @default(true)

  members    CourseContentSyncMember[]

  @@index([chairmanId])
}

model CourseContentSyncMember {
  id       String @id @default(cuid())
  groupId  String
  group    CourseContentSyncGroup @relation(fields: [groupId], references: [id])
  courseId String @unique // a course can only be in one content-sync group
  course   Course @relation(fields: [courseId], references: [id])
  // Exactly one member per group is the "base" — only the base course can
  // have a Subject Expert assigned and can have its content edited by
  // one; the others inherit and are read-only for SE purposes. Enforced
  // at the DB level too via a partial unique index (see the migration).
  isBase   Boolean @default(false)

  @@index([groupId])
}

model CourseEquivalenceGroup {
  id         String   @id @default(cuid())
  chairmanId String
  chairman   User     @relation("EquivalenceChairman", fields: [chairmanId], references: [id])
  createdById String? // which OMC member created this group
  name       String   // e.g. "Introduction to Programming (shared)"
  createdAt  DateTime @default(now())

  members    CourseEquivalenceMember[]
  sectionAssignments GroupSectionAssignment[]
  scheduleSections   ScheduleSection[]

  @@index([chairmanId])
}

model CourseEquivalenceMember {
  id       String @id @default(cuid())
  groupId  String
  group    CourseEquivalenceGroup @relation(fields: [groupId], references: [id])
  courseId String @unique // a course can only belong to one equivalence group
  course   Course @relation(fields: [courseId], references: [id])

  @@index([groupId])
}

// Faculty section allocation for a combined equivalence group — parallel to
// CourseSectionAssignment but for the group as a whole rather than one course.
model GroupSectionAssignment {
  id           String   @id @default(cuid())
  groupId      String
  group        CourseEquivalenceGroup @relation(fields: [groupId], references: [id])
  instructorId String
  instructor   User     @relation("GroupSectionInstructor", fields: [instructorId], references: [id])
  sectionCount Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([groupId, instructorId])
  @@index([groupId])
  @@index([instructorId])
}

// Dates a Coordinator has declared a holiday — no lecture auto-fills onto these.
model Holiday {
  id            String   @id @default(cuid())
  coordinatorId String
  coordinator   User     @relation("HolidayCoordinator", fields: [coordinatorId], references: [id])
  date          DateTime
  label         String

  @@unique([coordinatorId, date])
  @@index([coordinatorId])
}

// Marks a specific date as Online or On-Campus delivery — shown in delivery reports.
model ClassDayMode {
  id            String   @id @default(cuid())
  coordinatorId String
  coordinator   User     @relation("ClassDayModeCoordinator", fields: [coordinatorId], references: [id])
  date          DateTime
  mode          String   // "Online" | "OnCampus"

  @@unique([coordinatorId, date])
  @@index([coordinatorId])
}

// Continuous Quality Improvement — a record of a finding (from a report, an
// audit, or manual observation) and the action taken in response, tracked
// through to closure. Scoped to whichever batch/course it concerns.
model CqiRecord {
  id            String   @id @default(cuid())
  chairmanId    String
  chairman      User     @relation("CqiChairman", fields: [chairmanId], references: [id])
  authorId      String   // who raised this
  lastUpdatedById String? // who most recently edited status/action
  batchId       String?
  batch         Batch?   @relation(fields: [batchId], references: [id])
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  finding       String   @db.Text
  actionTaken   String?  @db.Text
  status        String   @default("open") // open | in-progress | closed | verified-effective | verified-ineffective
  sourceType    String?  // "CLO" | "PLO" | "PEO" | "GENERAL" — what kind of finding this is
  sourceReference String? // e.g. "CLO-3", "PLO-5", "PEO-1: ..." — which specific outcome this is about
  metricBefore  Float?   // the observed value (e.g. pass rate %) at the time this was raised
  metricAfter   Float?   // the same metric re-checked later, once the action has had a chance to take effect
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chairmanId])
  @@index([batchId])
  @@index([courseId])
}

// ===== Indirect PLO Attainment: stakeholder feedback surveys =====
// Alumni and Employers aren't system users — no login, just contact
// records the Coordinator maintains, similar in spirit to Student.
model Alumni {
  id             String   @id @default(cuid())
  chairmanId     String   // institution-wide scope — any faculty under any of this chairman's coordinators shares one pool
  chairman       User     @relation("AlumniChairman", fields: [chairmanId], references: [id])
  name           String
  email          String?
  rollNumber     String   // links back to their record as a student — important for tracking, and prevents duplicate entry
  degreeProgram  String
  graduationYear Int
  totalWorkExperienceYears Int? // optional — years of work experience since graduating
  addedById      String?  // which faculty member added this record — any faculty can add, but not duplicate an existing one
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED — reviewed by the chairman-designated custodian (User.isAlumniCustodian)
  reviewedById   String?
  reviewNote     String?  @db.Text
  createdAt      DateTime @default(now())

  responses   SurveyResponse[]
  employment  AlumniEmployment[]
  additionalDegrees AlumniAdditionalDegree[]
  @@unique([chairmanId, rollNumber])
  @@index([chairmanId])
}

model Employer {
  id              String   @id @default(cuid())
  chairmanId      String
  chairman        User     @relation("EmployerChairman", fields: [chairmanId], references: [id])
  organizationName String
  contactName     String?
  contactEmail    String?
  companySize     String?  // e.g. "1-10", "11-50", "51-200", "201-500", "500+"
  industryType    String?  // e.g. "Software Development", "Banking", "Telecom"
  scope            String?  // NATIONAL | MULTINATIONAL — for the employment of graduates (NBEAC SAR)
  addedById       String?  // which faculty member added this record — any faculty can add, but not duplicate an existing one
  status          String   @default("PENDING")
  reviewedById    String?
  reviewNote      String?  @db.Text
  createdAt       DateTime @default(now())

  responses  SurveyResponse[]
  employment AlumniEmployment[]
  @@unique([chairmanId, organizationName])
  @@index([chairmanId])
}

// One alumnus's employment at one employer, for one stretch of time — an
// alumnus can have many of these (career history), and an employer can have
// many alumni employed there (current or past).
model AlumniEmployment {
  id           String    @id @default(cuid())
  alumniId     String
  alumni       Alumni    @relation(fields: [alumniId], references: [id])
  employerId   String
  employer     Employer  @relation(fields: [employerId], references: [id])
  jobTitle     String?
  startDate    DateTime?
  endDate      DateTime? // null = current position
  salaryRange  String?   // optional, e.g. "PKR 80,000 - 100,000"
  addedById    String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([alumniId])
  @@index([employerId])
}

// A degree earned AFTER graduating from this institution (MS, PhD,
// professional certifications) — separate from the one original degree
// tracked directly on Alumni.
model AlumniAdditionalDegree {
  id             String   @id @default(cuid())
  alumniId       String
  alumni         Alumni   @relation(fields: [alumniId], references: [id])
  degreeName     String   // e.g. "MS Computer Science"
  institution    String   // e.g. "Stanford University"
  completionYear Int?
  addedById      String?
  status         String   @default("PENDING")
  reviewedById   String?
  reviewNote     String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([alumniId])
}

model SurveyTemplate {
  id              String   @id @default(cuid())
  coordinatorId   String
  coordinator     User     @relation("SurveyTemplateCoordinator", fields: [coordinatorId], references: [id])
  title           String
  stakeholderType String   // "STUDENT" | "ALUMNI" | "EMPLOYER"
  createdAt       DateTime @default(now())

  questions SurveyQuestion[]
  responses SurveyResponse[]
  @@index([coordinatorId])
}

model SurveyQuestion {
  id               String         @id @default(cuid())
  surveyTemplateId String
  surveyTemplate   SurveyTemplate @relation(fields: [surveyTemplateId], references: [id])
  text             String         @db.Text
  mappedPloId      String?
  mappedPlo        PLO?           @relation(fields: [mappedPloId], references: [id])
  mappedPeoLabel   String?        // PEOs aren't a separate table (see ProgramProfile.peos) — free-text label like "PEO-1", used for indirect PEO assessment via alumni/employer surveys
  orderIndex       Int            @default(0)

  answers SurveyAnswer[]
  @@index([surveyTemplateId])
  @@index([mappedPloId])
}

// One respondent's link into one survey — token-based, no login required.
// respondentId points at whichever stakeholder table matches respondentType.
model SurveyResponse {
  id               String         @id @default(cuid())
  surveyTemplateId String
  surveyTemplate   SurveyTemplate @relation(fields: [surveyTemplateId], references: [id])
  token            String         @unique
  respondentType   String         // "STUDENT" | "ALUMNI" | "EMPLOYER"
  respondentLabel  String         // display name, captured at creation time
  studentId        String?
  student          Student?       @relation(fields: [studentId], references: [id])
  alumniId         String?
  alumni           Alumni?        @relation(fields: [alumniId], references: [id])
  employerId       String?
  employer         Employer?      @relation(fields: [employerId], references: [id])
  submittedAt      DateTime?
  createdAt        DateTime       @default(now())

  answers SurveyAnswer[]
  @@index([surveyTemplateId])
  @@index([token])
  @@index([studentId])
  @@index([alumniId])
  @@index([employerId])
}

model SurveyAnswer {
  id               String         @id @default(cuid())
  surveyResponseId String
  surveyResponse   SurveyResponse @relation(fields: [surveyResponseId], references: [id])
  questionId       String
  question         SurveyQuestion @relation(fields: [questionId], references: [id])
  ratingValue      Int            // 1-5

  @@unique([surveyResponseId, questionId])
  @@index([questionId])
}

// A real student, imported by the Coordinator per batch (bulk CSV) — the
// foundation for marks entry and result computation.
model Student {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id])
  name       String
  rollNumber String
  createdAt  DateTime @default(now())

  // A student's own login — fully separate from staff auth (User/
  // Session) by design, so nothing here can ever affect or break
  // staff login. Null passwordHash = never activated yet; a Coordinator
  // sets/resets it (bootstrapped to the student's own roll number, same
  // pattern as staff onboarding), and mustChangePassword forces them to
  // pick their own on first login.
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  track      String   @default("Non-Medical") // which curriculum track this student follows — drives which track-specific courses (and deficiency courses) they are enrolled in
  currentSemesterNumber Int   @default(1) // the Coordinator advances this each term; drives which semester's courses are this student's own default enrollment
  // Where the student stands: still studying, graduated, left (non-academic reasons) or dropped (academic reasons).
  status         String    @default("ACTIVE") // ACTIVE | GRADUATED | LEFT | DROPPED
  statusDate     DateTime?
  statusReason   String?
  sessions           StudentSession[]

  enrollments StudentEnrollment[]
  marks       StudentMark[]
  labMarks    LabMark[]
  transcriptRecords StudentTranscriptRecord[]
  surveyResponses SurveyResponse[]
  attendanceRecords AttendanceRecord[]
  electiveChoices ElectiveChoice[]
  outOfBatchRequests OutOfBatchRequest[]
  degreePlanEntries DegreePlanEntry[]
  registrationApprovalRequests RegistrationApprovalRequest[]

  @@unique([batchId, rollNumber])
  @@index([batchId])
}

// Mirrors Session (used for staff/User) exactly, but fully independent
// — a different cookie, a different table, a different auth helper.
// Deliberately not reusing Session/User at all: those are the most
// security-sensitive, load-bearing models in the whole app, and this
// keeps zero risk of a student-auth change ever touching staff login.
model StudentSession {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  @@index([studentId])
}

// A student's request to enroll in a course belonging to a DIFFERENT
// batch than their own — e.g. a course only offered to a cohort ahead
// of or behind them, needed for degree completion due to their own
// unique progression. Requires explicit Coordinator approval; never
// auto-enrolls.
model OutOfBatchRequest {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id])
  reason       String?   @db.Text
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedBy   User?     @relation("OutOfBatchRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([courseId])
  @@index([studentId])
  @@index([reviewedById])
}

// A student's own draft plan for a future (not-yet-enrolled) course —
// which semester they intend to take it, and optionally a hypothetical
// grade for the GPA sandbox. Always points at a REAL Course row already
// sitting in the student's own batch (batches get their full curriculum
// imported up front, semesters just aren't "offered" yet until that
// term actually arrives) — never an invented placeholder, so the plan
// stays grounded in the institution's real curriculum. plannedSemesterNumber
// starts equal to the course's own semesterNumber but the student can
// move it elsewhere.
model DegreePlanEntry {
  id                    String   @id @default(cuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id])
  courseId              String
  course                Course   @relation(fields: [courseId], references: [id])
  plannedSemesterNumber Int
  hypotheticalGrade     String?  // a GradingScale letter, e.g. "A", "B+" — sandbox only, never a real grade
  createdAt             DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// A registration action (register or withdraw) that's held for an
// Advisor's decision instead of applying immediately — triggered by
// either an academic-standing override (student on Warning/Probation:
// ANY registration change needs approval) or a modified-plan flag
// (the course being registered isn't at the student's own current
// semester, i.e. they're deviating from the standard batch track).
// Approving it actually performs the underlying register/withdraw;
// rejecting it just discards the request, leaving nothing applied.
model RegistrationApprovalRequest {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id])
  actionType   String    // "REGISTER" | "WITHDRAW"
  reasonCode   String    // "ACADEMIC_STANDING" | "MODIFIED_PLAN"
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedBy   User?     @relation("RegistrationApprovalReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([studentId])
  @@index([courseId])
  @@index([reviewedById])
}

// A named elective slot (e.g. "Elective-I") for one batch/semester,
// offering multiple real, independently-taught courses as alternative
// options — each option keeps its own CLOs, content, and roster; this
// only groups them together for a combined view and for collecting
// student choices. Registration is a public, no-login form (same
// pattern as Feedback Surveys' distributed links) since students have
// no account in this system at all.
model ElectiveSlotGroup {
  id               String   @id @default(cuid())
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id])
  label            String   // e.g. "Elective-I"
  semesterNumber   Int
  coordinatorId    String
  coordinator      User     @relation("ElectiveGroupCoordinator", fields: [coordinatorId], references: [id])
  registrationOpen Boolean  @default(false)
  finalized        Boolean  @default(false) // once true, choices have been turned into real enrollments
  createdAt        DateTime @default(now())

  options ElectiveSlotOption[]
  choices ElectiveChoice[]

  @@index([batchId])
  @@index([coordinatorId])
}

model ElectiveSlotOption {
  id       String            @id @default(cuid())
  groupId  String
  group    ElectiveSlotGroup @relation(fields: [groupId], references: [id])
  courseId String            @unique // a course can only be one option, in one group
  course   Course            @relation(fields: [courseId], references: [id])
  capacity Int?              // null = unlimited

  choices ElectiveChoice[]

  @@index([groupId])
}

// One student's pick for one elective group — identified by roll
// number on the public form, not a login. Can be resubmitted (updates
// in place) while registration is still open; @@unique enforces one
// active choice per student per group.
model ElectiveChoice {
  id          String             @id @default(cuid())
  groupId     String
  group       ElectiveSlotGroup  @relation(fields: [groupId], references: [id])
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id])
  optionId    String
  option      ElectiveSlotOption @relation(fields: [optionId], references: [id])
  submittedAt DateTime           @default(now())
  applied     Boolean            @default(false) // whether this has become a real StudentEnrollment yet

  @@unique([groupId, studentId])
  @@index([optionId])
  @@index([studentId])
}

// A student taking a specific course — decoupled from their home batch so a
// repeat/summer enrollment into a different offering still works.
model StudentEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  isRepeat   Boolean  @default(false)
  status     String   @default("ACTIVE") // ACTIVE | WITHDRAWN — set by Advisor mid-semester
  withdrawnAt    DateTime?
  withdrawnById  String?
  withdrawnReason String?
  createdAt  DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

// A student's raw score on one specific assessment instrument (Quiz 1, Midterm
// Q3, etc.) — entered by the Instructor, matching the reference Excel's
// per-item mark sheet.
model StudentMark {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  instrumentId String
  instrument   AssessmentInstrument @relation(fields: [instrumentId], references: [id])
  score        Float
  enteredById  String
  updatedAt    DateTime @updatedAt

  @@unique([studentId, instrumentId])
  @@index([courseId])
  @@index([studentId])
  @@index([instrumentId])
}

// Semester-wide dates for an entire Degree Program — set once by the
// Coordinator, applied automatically to every course currently offered
// under that degree (a course can still override with its own dates if
// it genuinely differs).
model SemesterDates {
  id                 String   @id @default(cuid())
  coordinatorId      String
  coordinator        User     @relation("SemesterDatesCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram      String
  termName           String
  termYear           Int
  semesterStartDate  DateTime?
  midtermStartDate   DateTime?
  midtermEndDate     DateTime?
  finalStartDate     DateTime?
  finalEndDate       DateTime?

  @@unique([coordinatorId, degreeProgram, termName, termYear])
  @@index([coordinatorId])
}

// Singleton — truly platform-wide branding (Lets Innovate + NCEAC), the same
// across every tenant/institution on this SaaS deployment. Set exclusively
// The public marketing/landing page's editable text content — a single
// row, edited by the Super User. Feature list and testimonials are stored
// as JSON arrays for flexibility without needing separate tables.
model LandingPageContent {
  id              String  @id @default(cuid())
  headline        String  @default("Outcome-Based Education Governance, Built for Accreditation")
  subheadline     String  @db.Text @default("Design, deliver, and prove learning outcomes across your entire institution — from curriculum to classroom to accreditation report.")
  aboutText       String  @db.Text @default("")
  missionText     String  @db.Text @default("")
  contactEmail    String?
  contactPhone    String?
  pricingNote     String  @db.Text @default("")
  featuresJson    String  @db.Text @default("[]")
  testimonialsJson String @db.Text @default("[]")
  updatedAt       DateTime @updatedAt
}

// by the Super User. Per-institution branding lives on User (see Chairman's
// instituteName/instituteLogo) since each paying tenant has its own.
model PlatformSettings {
  id            String  @id @default("singleton")
  ownerLogo     String? @db.Text // base64 data URI — "Lets Innovate Pvt Ltd", used for copyright
  nceacLogo     String? @db.Text // base64 data URI — the NCEAC accreditation seal
}

// Program-wide grading scale — which letter grades exist and their GPA
// value, set exclusively by the Program Coordinator. Applies to every
// course they manage.
model GradingScale {
  id            String @id @default(cuid())
  coordinatorId String
  coordinator   User   @relation("GradingScaleCoordinator", fields: [coordinatorId], references: [id])
  letter        String // "A", "A-", "B+", etc.
  gpaValue      Float
  orderIndex    Int    @default(0) // highest grade first
  effectiveFromTerm String @default("Fall") // this version applies to batches whose OWN start term is on/after this point
  effectiveFromYear Int    @default(2000) // low default so pre-existing rows keep applying to every already-created batch

  @@unique([coordinatorId, letter, effectiveFromTerm, effectiveFromYear])
  @@index([coordinatorId])
}

// Per-course % cutoff for each letter grade — set by the Instructor
// (starting from the computed mean/SD suggestion), with the Chairman able
// to override for any course under their institution.
model CourseGradeCutoff {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  letter      String
  minPercent  Float
  setById     String   // who last set/changed this (Instructor or Chairman)
  updatedAt   DateTime @updatedAt

  @@unique([courseId, letter])
  @@index([courseId])
}

// A permanent snapshot of a course's section assignments for one specific
// past semester — taken automatically right before a course gets re-offered
// for a new term (which would otherwise overwrite offeredTermName/Year and
// lose the historical record). This is what "download a previous semester's
// assignments" reads from.
// A permanent snapshot of a course's CLO/PLO attainment for one specific
// past offering — taken automatically right before a course gets re-offered
// (which also clears StudentMark/StudentEnrollment for a fresh start, so
// old and new students' marks never mix). This is what "compare this
// offering to a past one" reads from.
// One student's permanent academic record for one course offering — taken
// automatically right before that course's StudentMark/StudentEnrollment
// get cleared on re-offering, so an individual's transcript survives across
// every semester, not just the current one.
model StudentTranscriptRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  coordinatorId String
  courseCode    String
  courseTitle   String
  creditHours   Int
  courseType    String
  termName      String
  termYear      Int
  totalPct      Float
  grade         String
  gpaPoints     Float?
  cloAttainmentJson String @db.Text // JSON: { code, pct, passed }[]
  ploAttainmentJson String @db.Text // JSON: { label, pct, passed }[]
  snapshotAt    DateTime @default(now())

  @@index([studentId])
  @@index([coordinatorId])
}

model AttainmentSnapshot {
  id            String   @id @default(cuid())
  coordinatorId String
  courseLabel   String
  termName      String
  termYear      Int
  studentCount  Int
  cloStatsJson  String   @db.Text // JSON: { code, maxWeight, passCount, failCount }[]
  ploStatsJson  String   @db.Text // JSON: { label, maxWeight, passCount, failCount }[]
  histogramJson String   @db.Text // JSON: { label, count }[]
  snapshotAt    DateTime @default(now())

  @@index([coordinatorId])
}

model AssignmentSnapshot {
  id             String   @id @default(cuid())
  coordinatorId  String
  courseLabel    String
  courseType     String
  batchLabel     String
  termName       String
  termYear       Int
  instructorName String
  sectionCount   Int
  snapshotAt     DateTime @default(now())

  @@index([coordinatorId])
  @@index([termName, termYear])
}

// Chairman-controlled access rules for reports — either role-wide or for a
// specific person, covering view and edit separately (edit only matters for
// reports with embedded actions, like Result Mate's grade cutoffs). No rule
// for a report/subject means the default (today's behavior: open to every
// role that's normally eligible) applies.
model ReportAccessRule {
  id            String  @id @default(cuid())
  chairmanId    String
  chairman      User    @relation("ReportAccessChairman", fields: [chairmanId], references: [id])
  reportId      String  // matches ReportDef.id in lib/reportRegistry.ts
  subjectType   String  // "ROLE" | "USER"
  subjectValue  String  // a role name (e.g. "INSTRUCTOR") or a User.id
  canView       Boolean @default(true)
  canEdit       Boolean @default(true)

  @@unique([chairmanId, reportId, subjectType, subjectValue])
  @@index([chairmanId])
}

// A saved set of reports for one-go printing. Platform-scope bundles (set
// by Super User) are shared across every institution; Coordinator-scope
// bundles are personal to that Coordinator (e.g. "NCEAC Visit Package").
model ReportBundle {
  id          String  @id @default(cuid())
  name        String
  description String?
  scope       String  // "PLATFORM" | "COORDINATOR"
  ownerId     String? // the Coordinator's User.id — null for PLATFORM bundles
  reportIds   String  @db.Text // JSON array of report ids from lib/reportRegistry.ts

  @@index([ownerId])
}

// Program-level narrative content for the full program document (Annex-A
// style) — department intro/vision/mission and PEOs, which nothing else in
// the system tracks. Optional: the document generates fine without it, just
// skipping those sections.
model ProgramProfile {
  id                 String @id @default(cuid())
  coordinatorId      String
  coordinator        User   @relation("ProgramProfileCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram      String
  departmentIntro    String? @db.Text
  departmentVision   String? @db.Text
  departmentMission  String? @db.Text
  peos               String? @db.Text // JSON array of strings
  // NBEAC SAR: the program's level, launch, approvals and the PEO-PLO alignment.
  programLevel       String? // UG16 | GRAD18 | PHD
  launchDate         DateTime?
  academicCouncilDate DateTime?
  hecNocDate         DateTime?
  peoPloJson         String? @db.Text // JSON: { "PEO1": [1, 3], ... } — the PLO numbers each PEO is served by

  @@unique([coordinatorId, degreeProgram])
}

model Course {
  id                  String   @id @default(cuid())
  code                String
  title               String
  creditHours         Int
  courseType          String   @default("Core") // Core | Elective | Lab | IDS | General Education | Capstone Project | Field Experience
  hasLab              Boolean  @default(true) // whether this course has a lab component — when false, Lab % is locked to 0 in weight-setting
  trackName           String?  // null = part of EVERY track's plan; otherwise ONLY students on this track take it (e.g. "Pre-Medical"). A track's semester plan = courses with no trackName + courses with that trackName.
  isNonCredit         Boolean  @default(false) // deficiency / remedial course: no credit hours, never counted in semester credit totals or CGPA — must simply be passed (see PassingCriteria.deficiencyPassingPct)
  contactHours        Int?     // weekly contact hours when it can't be derived from creditHours (a non-credit course still meets, e.g. 3 h/week). null = derive from credit hours as before.
  semesterNumber      Int?     // 1..8, which semester this is offered in
  coordinatorId       String
  coordinator         User     @relation("CourseCoordinator", fields: [coordinatorId], references: [id])
  batchId             String?  // which cohort/intake this course offering belongs to
  batch               Batch?   @relation(fields: [batchId], references: [id])
  subjectExpertId     String?
  subjectExpert       User?    @relation("CourseSubjectExpert", fields: [subjectExpertId], references: [id])
  instructorId        String?
  instructor          User?    @relation("CourseInstructor", fields: [instructorId], references: [id])
  loans                   TeacherLoanRequest[] @relation("CourseLoans")
  instructorResponse      String   @default("NONE") // NONE | PENDING | ACCEPTED | DECLINED - a borrowed teacher accepts or declines the course given to them
  instructorResponseNote  String?
  seResponse              String   @default("NONE") // same, for a borrowed Subject Expert
  seResponseNote          String?
  instructorApproval      String   @default("NONE") // NONE | PENDING | APPROVED | REJECTED - the department head signs off a teacher assignment
  instructorApprovalNote  String?
  instructorApprovedById  String?
  instructorApprovedAt    DateTime?
  subjectHomeDepartmentId String? // optional: the department whose subject expertise this course draws on (e.g. a CS program's Management course -> Management Science)
  subjectHomeDepartment   Department? @relation("CourseSubjectHome", fields: [subjectHomeDepartmentId], references: [id])
  isOffered           Boolean  @default(false) // whether this course has been activated for its current-semester offering
  offeredTermName     String?  // "Fall" | "Spring" — which term this was offered in, stamped when isOffered becomes true
  offeredTermYear     Int?
  midtermWeek         Int?     // topics taught up to and including this week count as "before the midterm" (null = worked out from the lecture plan)
  midtermStartDate    DateTime? // set by Coordinator (override) — no lecture auto-fills within this range
  midtermEndDate      DateTime?
  finalStartDate      DateTime?
  finalEndDate        DateTime?
  masterCourseId      String?  // traceability: which HEC/Master course this was adopted from, if any
  masterCourse        MasterCourse? @relation(fields: [masterCourseId], references: [id])
  benchmarkSourceId   String?  // which prior batch's course this template was copied from, if any
  benchmarkSource     Course?  @relation("BenchmarkLineage", fields: [benchmarkSourceId], references: [id])
  benchmarkCopies     Course[] @relation("BenchmarkLineage")
  prerequisiteCourseId String? // the course that should be taken before this one
  prerequisiteCourse  Course?  @relation("PrerequisiteLineage", fields: [prerequisiteCourseId], references: [id])
  postrequisiteCourses Course[] @relation("PrerequisiteLineage")
  createdAt           DateTime @default(now())

  // Gold-standard template fields, set by the Subject Expert
  templateStatus      String   @default("draft") // draft | submitted | approved | changes-requested
  // Load-balancing only — every OMC member can still see, comment on,
  // and even approve/reject ANY course regardless of this field. This
  // just marks who's primarily responsible for getting to it, so the
  // team can split up the queue instead of everyone reviewing whatever
  // catches their eye.
  assignedOmcReviewerId String?
  assignedOmcReviewer   User?  @relation("CourseOmcReviewer", fields: [assignedOmcReviewerId], references: [id])
  customCategoryId String?
  customCategory   CustomCategory? @relation(fields: [customCategoryId], references: [id])
  outOfBatchRequests OutOfBatchRequest[]
  degreePlanEntries DegreePlanEntry[]
  registrationApprovalRequests RegistrationApprovalRequest[]
  assignmentPct       Int      @default(15)
  quizPct             Int      @default(20)
  projectPct          Int      @default(0)
  labPct              Int      @default(0)
  midtermPct          Int      @default(25)
  finalPct            Int      @default(40)
  // How many separate items (quizzes, assignments, exam questions...) the
  // SE wants for each category — shown on the Assessment Weights tab,
  // pre-filled from the OMC's policy minimum count and raisable by the SE.
  // Saving weights auto-creates instruments on the Assessments tab up to
  // this count (splitting the category % evenly across them) so the SE
  // doesn't have to add each one by hand. Null means not set yet; the
  // OMC's minimum (or 1) is used as the default shown in the form.
  assignmentCount     Int?
  quizCount           Int?
  projectCount        Int?
  labCount            Int?
  midtermCount        Int?
  finalCount          Int?
  // "Best of N" — count only the N best-scoring Quizzes/Assignments toward
  // the final grade (drop the lowest-scoring ones), e.g. best 3 of 5
  // quizzes. Null or >= the item count means "count all, drop nothing".
  // Only affects the GPA/CGPA grade total — CLO/PLO attainment always
  // uses every instrument, since dropping a quiz there would misrepresent
  // whether the CLO it tests was actually met.
  quizBestOf          Int?
  assignmentBestOf    Int?
  // Set when the SE's weights are saved within the OMC's policy range (or
  // an out-of-range exception is approved) — gates the Assessments &
  // Submit tab, which can't be used until this is set. Null means the
  // weightage step hasn't been explicitly confirmed yet.
  weightsConfirmedAt  DateTime?
  omcComment          String?  @db.Text // latest OMC review comment on this template
  templateReviewedById String? // which OMC member last reviewed/approved/rejected this template

  // Extra fields for the Course Description Form / accreditation paperwork
  textbook            String?  @db.Text
  referenceMaterial   String?  @db.Text
  catalogDescription  String?  @db.Text
  // NBEAC SAR: courses designed for corporate needs, addressing indigenous issues, and how the course is taught.
  corporateRelevance  String?  @db.Text
  indigenousFocus     String?  @db.Text
  teachingMethods     String? // comma-separated: Lecturing, Case studies, Simulations, ...
  programmingAssignmentsNote String? @db.Text
  labInstructorName   String?
  instructorObservations String? @db.Text // free-text notes for the Course Evaluation Form ("Instructors Observations")

  // Instructor's OWN copy of the weights (separate from SE's plan above),
  // populated when the Instructor first opens their delivery page.
  instructorAssignmentPct Int?
  instructorQuizPct       Int?
  instructorProjectPct    Int?
  instructorLabPct        Int?
  instructorMidtermPct    Int?
  instructorFinalPct      Int?
  // Same idea as weightsConfirmedAt above, for the Instructor's own copy.
  instructorWeightsConfirmedAt DateTime?
  // The Instructor's own number of items per category and "best of" choice (same meaning as assignmentCount /
  // quizBestOf above, for the delivery copy). Null = not set yet: the Subject Expert's plan is used.
  instructorAssignmentCount   Int?
  instructorQuizCount         Int?
  instructorProjectCount      Int?
  instructorLabCount          Int?
  instructorMidtermCount      Int?
  instructorFinalCount        Int?
  instructorQuizBestOf        Int?
  instructorAssignmentBestOf  Int?

  clos                CLO[]
  lectureRows         LectureRow[]
  paperDistributionItems PaperDistributionItem[]
  attendanceRecords   AttendanceRecord[]
  scheduleSections    ScheduleSection[]
  ploMappings         CoursePloMapping[]
  weightExceptions    WeightExceptionRequest[]
  assessmentInstruments AssessmentInstrument[]
  sectionAssignments  CourseSectionAssignment[]
  labEngineerId       String?  // Lab courses only: the Lab Engineer who sets the lab manuals and enters lab marks
  labEngineer         User?    @relation("CourseLabEngineer", fields: [labEngineerId], references: [id])
  labManuals          LabManual[]
  labMarks            LabMark[]
  equivalenceMember   CourseEquivalenceMember?
  feedForwardNotes    FeedForwardNote[]
  guidanceComments    InstructorGuidanceComment[]
  cqiRecords          CqiRecord[]
  studentEnrollments  StudentEnrollment[]
  gradeCutoffs        CourseGradeCutoff[]
  studentMarks        StudentMark[]
  contentSyncMember   CourseContentSyncMember?
  electiveOption      ElectiveSlotOption?

  @@unique([coordinatorId, batchId, code])
  @@index([coordinatorId])
  @@index([batchId])
  @@index([subjectExpertId])
  @@index([instructorId])
  @@index([subjectHomeDepartmentId])
  @@index([masterCourseId])
  @@index([benchmarkSourceId])
  @@index([prerequisiteCourseId])
  @@index([assignedOmcReviewerId])
  @@index([customCategoryId])
  @@index([labEngineerId])
}

// Left by an instructor at any point (typically end of semester) for whoever
// teaches this course next — either the next batch's instance of the same
// course, or a course that lists this one as its prerequisite.
model FeedForwardNote {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([courseId])
}

// A running thread between OMC and the Instructor about this specific
// course's delivery — visible throughout the semester, not gated behind a
// submit action.
model InstructorGuidanceComment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  authorId   String
  authorRole String   // "OMC" | "INSTRUCTOR"
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([courseId])
}

// Institutional/Program PLOs — defined by the Program Coordinator (optionally
// starting from a HEC PLO as a template), editable and formally approved by
// the Chairman. CLOs map to THESE, not directly to the read-only HEC list,
// so the institution's actual approved PLOs are what's authoritative.
model PLO {
  id                    String   @id @default(cuid())
  coordinatorId         String
  coordinator           User     @relation("PloCoordinator", fields: [coordinatorId], references: [id])
  batchId               String   // PLOs are scoped per BATCH — even two cohorts of the same degree can differ
  batch                 Batch    @relation("BatchPlos", fields: [batchId], references: [id])
  number                Int
  title                 String
  description           String   @db.Text
  sourceMasterPloNumber Int?     // which HEC PLO this was copied from, if any — traceability only
  status                String   @default("draft") // draft | approved | changes-requested
  chairmanComment       String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clos                  CLO[]
  ploMappings           CoursePloMapping[]
  surveyQuestions       SurveyQuestion[]

  @@unique([batchId, number])
  @@index([coordinatorId])
  @@index([batchId])
}

// OMC assigns which PLOs each course contributes to — a many-to-many matrix,
// not something a Subject Expert or Coordinator sets themselves.
// HEC's suggested course-to-PLO mapping, from the NCEAC workbook — used by
// the "Auto-Map from HEC" button to bulk-create real CoursePloMapping
// records for a batch, matched by course code.
// A faculty member's own stated interest in teaching a given course code
// — set on their own portal, visible to the Course Assigner as a
// color-coded hint. No record for a (facultyId, courseCode) pair means
// "not interested" (the default) rather than an explicit 4th value.
// A short, human-chosen display name for a course code — used only in
// the Section Assignment Matrix (and anywhere else space is tight) to
// avoid the auto-generated first-3-letters abbreviation, which often
// isn't distinguishable between courses. Purely cosmetic — never
// touches the real course code or title anywhere else in the app.
// Scoped per chairman/institution, since two different institutions
// could reuse the same course code for unrelated courses.
model CourseShortName {
  id         String @id @default(cuid())
  chairmanId String
  chairman   User   @relation("CourseShortNameChairman", fields: [chairmanId], references: [id])
  courseCode String
  shortName  String
  updatedAt  DateTime @updatedAt

  @@unique([chairmanId, courseCode])
}

model FacultyCoursePreference {
  id         String @id @default(cuid())
  facultyId  String
  faculty    User   @relation("FacultyCoursePreferenceFaculty", fields: [facultyId], references: [id])
  courseCode String
  priority   Int    // 1 = top priority, 2 = good, 3 = fifty-fifty
  createdAt  DateTime @default(now())

  @@unique([facultyId, courseCode])
  @@index([facultyId])
  @@index([courseCode])
}

model HecPloSuggestion {
  id         String @id @default(cuid())
  courseCode String
  ploNumber  Int

  @@unique([courseCode, ploNumber])
  @@index([courseCode])
}

model CoursePloMapping {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  ploId        String
  plo          PLO      @relation(fields: [ploId], references: [id])
  assignedById String   // the OMC member who made this assignment (or whose action triggered it)
  source       String?  // "HEC" | "SYSTEM" | "MANUAL" — how this mapping came to exist, kept
                         // permanently for reference even after the checkbox is checked (HEC/SYSTEM
                         // suggestion hints disappear from an unchecked cell once it's set, so without
                         // this the origin would otherwise be lost the moment it's applied). null on
                         // rows created before this field existed.
  createdAt    DateTime @default(now())

  @@unique([courseId, ploId])
  @@index([courseId])
  @@index([ploId])
}

// CLOs set by the Subject Expert for a course
model CLO {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  source      String   @default("SE") // "SE" | "INSTRUCTOR" — SE's plan vs the Instructor's own delivery copy
  code        String   // "CLO-1"
  statement   String   @db.Text
  bloomLevel  String   // C1..C6
  mappedPloId String?  // references the institution's own PLO (see PLO model)
  mappedPlo   PLO?     @relation(fields: [mappedPloId], references: [id])
  ploMappingSource String? // "MANUAL" | "SYSTEM" — MANUAL: a Subject Expert or
                           // Instructor deliberately chose this PLO. SYSTEM:
                           // bulk-suggested by keyword matching against this
                           // course's own PLO wording, unverified — shown
                           // differently in the CLO editor so it's never
                           // mistaken for a deliberate choice until reviewed.
                           // Mirrors MasterCourseClo's own ploMappingSource.
  ploContributionPct Int? // this CLO's % contribution toward mappedPlo's attainment —
                          // when several CLOs in the same course map to the same PLO,
                          // their contributions must sum to 100 (enforced at submit time)
  targetPct   Int      @default(60) // NBA/Washington-Accord style: % of students expected to attain this CO — compared against actual attainment on the Program Attainment Analytics dashboard
  orderIndex  Int      @default(0) // display order — code is auto-derived from this ("CLO-1", "CLO-2"...) so it's never manually typed and never has gaps
  createdAt   DateTime @default(now())

  lectureRows LectureRow[]
  paperDistributionItems PaperDistributionItem[]

  @@unique([courseId, source, code])
  @@index([courseId])
  @@index([mappedPloId])
}

// Final/mid-term paper distribution — one row per question, built by SE
// (planning) or Instructor (actual exam), picking a topic from the course's
// own lecture plan so the CLO and cognitive level come from real course
// data rather than being retyped.
model PaperDistributionItem {
  id             String      @id @default(cuid())
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id])
  source         String      @default("SE") // "SE" | "INSTRUCTOR"
  examType       String?     // "Midterm" | "Final" — which paper this question belongs to. Nullable only
                              // for rows created before this field existed; every new item sets it, and
                              // question numbering (questionNo) restarts at 1 within each examType.
  questionNo     Int         // auto-numbered in display order (within its examType), never manually typed
  lectureRowId   String?     // optional link to the topic/lecture this question is drawn from
  lectureRow     LectureRow? @relation(fields: [lectureRowId], references: [id])
  topicText      String      // pre-filled from the linked lecture row's topic, but editable
  cloId          String?
  clo            CLO?        @relation(fields: [cloId], references: [id])
  cognitiveLevel String?     // C1..C6 — pre-filled from the topic's Bloom level, but editable since one topic can spawn questions at different levels
  marks          Float
  orderIndex     Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([courseId])
  @@index([lectureRowId])
  @@index([cloId])
}

// The 30-lecture schedule set by the Subject Expert
model LectureRow {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  source        String   @default("SE") // "SE" | "INSTRUCTOR"
  week          Int
  lectureNumber Int
  topic         String
  subtopic      String?
  cloId         String?
  clo           CLO?     @relation(fields: [cloId], references: [id])
  bloomLevel    String?  // C1..C6
  weightPct     Float    @default(0) // auto-computed: sum of linked instruments' marksPct
  actualDate    DateTime? // Instructor-only: the real calendar date this lecture happened
  rescheduledNote String? // set by auto-fill when a holiday/exam date pushed this lecture off its natural weekly slot
  teachingMethod  String? // how this session is taught (lecture, case study, role play, ...)
  teachingMaterials String? // what is used: readings, case, video, software

  instrumentLinks LectureRowInstrument[]
  paperDistributionItems PaperDistributionItem[]
  attendanceRecords AttendanceRecord[]

  @@unique([courseId, source, lectureNumber])
  @@index([courseId])
  @@index([cloId])
}

// A specific gradeable item (Quiz 1, Assignment 2, Midterm Q3, Final Q5...)
// worth a defined % of the course's total marks. Lecture rows link to
// whichever instruments test that topic, and their contribution % is the
// sum of those instruments' marksPct — not a manually typed guess.
model AssessmentInstrument {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  source    String   @default("SE") // "SE" | "INSTRUCTOR"
  type      String   // Assignment | Quiz | Midterm | Final | Project | Lab
  label     String   // "Quiz 1", "Midterm Q3"
  marksPct  Float    // this instrument's % of total course marks
  cloId     String?  // Project / Lab measured against one CLO directly (not through lecture topics)
  partOfId  String?  // a part of a split Project / Lab (the original item stays as a 0% container, e.g. for its rubric)
  maxScore  Int      @default(10) // the raw marks this instrument is scored out of (e.g. Quiz out of 10)
  createdAt DateTime @default(now())

  lectureLinks LectureRowInstrument[]
  studentMarks StudentMark[]
  evidence     InstrumentEvidence[]

  @@index([courseId])
}

// DotAI-style evidence: the rubric, exam paper, or project brief behind
// an instrument, checked against every CLO that instrument's linked
// LectureRows map to (via LectureRowInstrument -> LectureRow -> CLO).
// A real AI check runs when ANTHROPIC_API_KEY is configured server-side;
// otherwise a deterministic keyword-overlap fallback runs instead, so a
// review is never blocked on having AI configured.
model InstrumentEvidence {
  id               String   @id @default(cuid())
  instrumentId     String
  instrument       AssessmentInstrument @relation(fields: [instrumentId], references: [id])
  fileName         String
  fileUrl          String   @db.Text // Supabase Storage public/signed URL
  uploadedByUserId String
  status           String   @default("PENDING") // PENDING | VALIDATED | FLAGGED | ERROR
  method           String?  // "AI" | "DETERMINISTIC" — which check actually ran
  reasoning        String?  @db.Text // the AI's explanation, or the fallback's note
  checkedCloIds    String?  @db.Text // JSON array of CLO ids this evidence was checked against
  createdAt        DateTime @default(now())
  validatedAt      DateTime?

  @@index([instrumentId])
}

model LectureRowInstrument {
  id           String   @id @default(cuid())
  lectureRowId String
  lectureRow   LectureRow @relation(fields: [lectureRowId], references: [id])
  instrumentId String
  instrument   AssessmentInstrument @relation(fields: [instrumentId], references: [id])

  @@unique([lectureRowId, instrumentId])
  @@index([lectureRowId])
  @@index([instrumentId])
}

// ============================================================================
// LAYER 1 — OFFICIAL MASTER CURRICULUM
// Seeded from real HEC notifications (see prisma/hec-bscs-2025.ts). Immutable
// once published — institutions adopt a copy via Course.masterCourseId, they
// never edit these rows directly.
// ============================================================================

// A prospective Chairman's request for a new institution account —
// public, no login required to submit. A Super User reviews and either
// approves (which creates the Chairman account and clones the grand
// curriculum for them in one step) or rejects it.
model AccountRequest {
  id              String    @id @default(cuid())
  name            String
  email           String
  institutionName String
  phone           String?
  message         String?   @db.Text
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedById    String?
  reviewedBy      User?     @relation("AccountRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?   @db.Text
  createdChairmanId String? // set once approved, so the reviewer can jump straight to the new account
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([reviewedById])
}

// An institution's own course/faculty classification, entirely separate
// from HEC's official courseType (Core/Elective/Lab/IDS/...) — e.g.
// "Fundamentals", "Management", "Maths", "Engineering", "Specialization
// Elective". Shared across every program under one chairman, since
// these groupings are usually institution-wide, not per-degree. Used to
// tag both courses and faculty with the same labels, so the Coordinator
// can match one against the other when assigning instructors.
model CustomCategory {
  id         String   @id @default(cuid())
  chairmanId String
  chairman   User     @relation("CustomCategoryChairman", fields: [chairmanId], references: [id])
  name       String
  createdAt  DateTime @default(now())

  courses  Course[]
  faculty  User[]   @relation("FacultyCustomCategory")

  @@unique([chairmanId, name])
}

model MasterCurriculum {
  id                 String   @id @default(cuid())
  authority          String   // "HEC", "NCEAC", etc.
  title              String   // "BS Computer Science"
  version            String   // "2025"
  publicationDate    DateTime?
  sourceReference    String?  // e.g. "HEC/NCRC/CS&IT/2025/8163"
  status             String   @default("PUBLISHED") // DRAFT | PUBLISHED | SUPERSEDED
  createdAt          DateTime @default(now())
  // The specific degree program this curriculum is for — e.g. "BS
  // Computer Science", "BS Artificial Intelligence". Null for the one
  // grand HEC curriculum, which spans every discipline's electives
  // rather than belonging to a single program.
  degreeProgram       String?
  // The grand HEC curriculum this program copy was built from, if any
  // — lets the sync mechanism trace a program copy (and, transitively,
  // any institute clone of it) back to its HEC source.
  parentCurriculumId  String?
  parentCurriculum    MasterCurriculum? @relation("ProgramCopyParent", fields: [parentCurriculumId], references: [id])
  programCopies       MasterCurriculum[] @relation("ProgramCopyParent")
  // Null = the shared, official reference copy — visible to every
  // chairman, but never directly editable by OMC (only a Super User
  // curator edits the official copy). Set = a specific chairman's own
  // clone, freely editable by their OMC, invisible to every other
  // chairman. Cloning exists specifically so a chairman can adapt HEC's
  // curriculum for their own future imports without ever touching the
  // shared original other institutions rely on too.
  chairmanId         String?
  chairman           User?    @relation("MasterCurriculumOwner", fields: [chairmanId], references: [id])

  courses            MasterCourse[]
  plos               MasterPLO[]
  pendingCourses     PendingMasterCourse[]
  assignments        CurriculumAssignment[] // which institutes (chairmen) the Super User has made this official curriculum available to

  @@index([chairmanId])
  @@index([parentCurriculumId])
}

// The Super User decides which institutes (Chairmen) can see and use each official
// (shared, chairmanId = null) master curriculum. Assigning one also gives the
// institute its own editable copy; removing the assignment just stops the
// official one from being offered — the institute's own copy stays theirs.
// An institute (Chairman) is split into departments. A department has heads (HEAD_OF_DEPARTMENT users),
// owns degree programs, and has its own coordinators, course assigners and faculty.
model Department {
  id         String   @id @default(cuid())
  chairmanId String
  chairman   User     @relation("DepartmentChairman", fields: [chairmanId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  facultyId  String?  // the faculty (led by a Dean) this department belongs to
  faculty    Faculty? @relation("FacultyDepartments", fields: [facultyId], references: [id], onDelete: SetNull)

  members    User[]              @relation("DepartmentMembers")
  programs   DepartmentProgram[]
  subjectHomeCourses Course[]    @relation("CourseSubjectHome")
  timetableMode String @default("SHARED") // SHARED = one common timetable with the other shared departments | SEPARATE = its own timetable and its own rooms
  rooms Room[] @relation("RoomDepartment")
  loansRequested TeacherLoanRequest[] @relation("LoanRequesting")
  loansRequestedFrom TeacherLoanRequest[] @relation("LoanLending")

  @@unique([chairmanId, name])
  @@index([chairmanId])
  @@index([facultyId])
}

// Which department a degree program (by name, e.g. "BS Computer Science") belongs to.
model DepartmentProgram {
  id            String   @id @default(cuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  chairmanId    String   // denormalised so one program can belong to only one department per institute
  degreeProgram String
  // The accreditation council whose rules and forms govern the program (NCEAC | NBEAC | HEC), set by the Institute Head.
  accreditationBody String?
  bodySetAt         DateTime?
  bodySetById       String?

  @@unique([chairmanId, degreeProgram])
  @@index([departmentId])
}

model CurriculumAssignment {
  id           String   @id @default(cuid())
  curriculumId String
  curriculum   MasterCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  chairmanId   String
  chairman     User     @relation("CurriculumAssignmentChairman", fields: [chairmanId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([curriculumId, chairmanId])
  @@index([chairmanId])
}

model MasterCourse {
  id                  String   @id @default(cuid())
  masterCurriculumId  String
  masterCurriculum    MasterCurriculum @relation(fields: [masterCurriculumId], references: [id])
  code                String   // suggested numbering — not an official HEC code, see seed file comment
  title               String
  creditHours         Int
  category            String   // General Education | Major | IDS | Certification | Capstone Project | Field Experience
  domain              String?  // for Domain Elective courses: which specialization track it belongs to
                                // (e.g. "Artificial Intelligence", "Cyber Security") — used to group
                                // electives when building a program-specific copy of a grand curriculum
  semesterNumber      Int?
  prerequisiteCourseId String? // the course that should be taken before this one, within the same curriculum —
                                // mirrors the real Course model's prerequisiteCourseId
  prerequisiteCourse  MasterCourse? @relation("MasterPrerequisiteLineage", fields: [prerequisiteCourseId], references: [id])
  postrequisiteCourses MasterCourse[] @relation("MasterPrerequisiteLineage")
  textbook            String?  // flows into every Course created from this template on import
  catalogDescription  String?  @db.Text
  referenceMaterial    String?

  designerId          String?  // the platform Subject Expert responsible for designing this course's content
  designer            User?    @relation("MasterCourseDesigner", fields: [designerId], references: [id])
  adoptedInto         Course[]
  seedClos            MasterCourseClo[]
  seedTopics          MasterCourseTopic[]

  @@index([masterCurriculumId])
  @@index([prerequisiteCourseId])
  @@unique([masterCurriculumId, code])
  @@index([designerId])
}

// HEC's stated learning outcomes for a major course — seeded as a starting
// CLO draft when the course is first adopted into a batch.
model MasterCourseClo {
  id             String @id @default(cuid())
  masterCourseId String
  masterCourse   MasterCourse @relation(fields: [masterCourseId], references: [id])
  statement      String @db.Text
  bloomLevel     String // C1..C6, inferred from the outcome's verb
  orderIndex     Int    @default(0)
  mappedPloId    String? // references this same curriculum's own MasterPLO —
                          // mirrors the real CLO model's mappedPloId, one primary
                          // PLO per CLO (not several), matching how the source
                          // HEC document itself tags each CLO
  mappedPlo      MasterPLO? @relation(fields: [mappedPloId], references: [id])
  ploMappingSource String? // "HEC" | "SYSTEM" — HEC: the official document
                           // itself tagged this CLO with a PLO number. SYSTEM:
                           // inferred from the CLO's verbs/content by keyword
                           // rules, unverified — shown differently in the
                           // Course-PLO matrix so the two are never confused

  @@index([masterCourseId])
  @@index([mappedPloId])
}

// A real (or standard-curriculum-synthesized) 32-lecture topic breakdown for
// a major course — seeded as a starting draft on the Lecture Content tab.
model MasterCourseTopic {
  id             String @id @default(cuid())
  masterCourseId String
  masterCourse   MasterCourse @relation(fields: [masterCourseId], references: [id])
  lectureNumber  Int    // 1..32
  topic          String
  subtopic       String?
  cloNumber      Int?   // which of the course's CLOs this lecture serves (1 = CLO-1, in CLO order)

  @@unique([masterCourseId, lectureNumber])
  @@index([masterCourseId])
}

model MasterPLO {
  id                  String   @id @default(cuid())
  masterCurriculumId  String
  masterCurriculum    MasterCurriculum @relation(fields: [masterCurriculumId], references: [id])
  number              Int
  title               String
  description         String   @db.Text

  mappedClos          MasterCourseClo[]

  @@index([masterCurriculumId])
  @@unique([masterCurriculumId, number])
}

// Per-institution AI configuration — lets a Chairman bring their own
// provider/model/API key rather than relying on one platform-wide key.
// Evidence validation (DotAI) and CQI auto-drafting both check here
// first, falling back to the platform's own ANTHROPIC_API_KEY env var
// if the institution hasn't configured one — so nothing breaks for
// institutions that never set this up.
model AiConfig {
  id            String   @id @default(cuid())
  chairmanId    String   @unique
  chairman      User     @relation("AiConfigChairman", fields: [chairmanId], references: [id])
  provider      String   @default("anthropic") // "anthropic" | "openai" — only anthropic actually wired up initially
  apiKey        String?  @db.Text // stored as given; only ever displayed masked (last 4 chars) in the UI
  model         String   @default("claude-sonnet-4-6")
  enabled       Boolean  @default(false)
  chatbotEnabled    Boolean @default(false) // OBE Assistant chat for faculty (Institute Head decides)
  chatbotDailyLimit Int     @default(20)    // questions per person per day
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestNote  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A newly-fetched/researched course (e.g. from a web research pass)
// staged for Super User review before it's permanently embedded in a
// master curriculum — the "equate courses" workflow: the reviewer sees
// this alongside a fuzzy-matched existing course (if any) and either
// confirms it as that same course (discarding the duplicate, or
// merging its CLOs in), or confirms it as a genuinely new course
// (creating a real MasterCourse from this staged data), or rejects it
// outright.
model PendingMasterCourse {
  id                 String   @id @default(cuid())
  masterCurriculumId String
  masterCurriculum   MasterCurriculum @relation(fields: [masterCurriculumId], references: [id])
  title              String
  suggestedCode      String?
  category           String?  // General Education | Major | Domain Elective | ...
  domain             String?
  source             String   @db.Text // where this was fetched from — e.g. "NUST course_content_files, CS-343" or "web research pass, 2026-09-20"
  status             String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())

  clos               PendingMasterCourseClo[]

  @@index([masterCurriculumId])
  @@index([status])
}

model PendingMasterCourseClo {
  id                     String @id @default(cuid())
  pendingMasterCourseId  String
  pendingMasterCourse    PendingMasterCourse @relation(fields: [pendingMasterCourseId], references: [id])
  statement              String @db.Text
  bloomLevel             String
  orderIndex             Int    @default(0)

  @@index([pendingMasterCourseId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

// A course shared in the public library: a frozen snapshot of the author's
// plan (CLOs, lecture plan, assessments, weights, paper distribution) that
// teachers at ANY institute can search and import into one of their own
// courses. Importing always makes an independent editable copy.
model PublicCourse {
  id                String   @id @default(cuid())
  authorId          String
  author            User     @relation("PublicCourseAuthor", fields: [authorId], references: [id])
  sourceCourseId    String?  // the author's own course it was published from (informational only)
  plan              String   @default("SE") // "SE" | "INSTRUCTOR" — whose version of the plan this snapshot holds
  instituteName     String?  // author's institute at publish time
  authorOrganization String? // industry / other organisation, if any
  code              String
  title             String
  creditHours       Int
  courseType        String   @default("Core")
  summary           String?  @db.Text
  searchText        String   @db.Text // lower-cased code, title, summary, author, institute and CLO text — what search matches against
  snapshotJson      String   @db.Text
  status            String   @default("PENDING") // PENDING | PUBLIC | REJECTED | WITHDRAWN
  reviewedById      String?
  reviewedAt        DateTime?
  reviewComment     String?  @db.Text
  version           Int      @default(1)
  importCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  imports           PublicCourseImport[]

  @@index([status])
  @@index([authorId])
}

model PublicCourseImport {
  id                  String   @id @default(cuid())
  publicCourseId      String
  publicCourse        PublicCourse @relation(fields: [publicCourseId], references: [id])
  importedById        String
  importedIntoCourseId String
  createdAt           DateTime @default(now())

  @@index([publicCourseId])
}

// One department asking another to lend a teacher for a course. The lending head decides.
model TeacherLoanRequest {
  id                     String   @id @default(cuid())
  chairmanId             String
  courseId               String
  course                 Course   @relation("CourseLoans", fields: [courseId], references: [id], onDelete: Cascade)
  kind                   String   @default("INSTRUCTOR") // INSTRUCTOR (Course Assigner asks) | SUBJECT_EXPERT (OMC asks)
  instructorId           String?  // the specific teacher asked for; null = "any suitable teacher, the lending head chooses"
  instructor             User?    @relation("LoanInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  requestingDepartmentId String
  requestingDepartment   Department @relation("LoanRequesting", fields: [requestingDepartmentId], references: [id], onDelete: Cascade)
  lendingDepartmentId    String
  lendingDepartment      Department @relation("LoanLending", fields: [lendingDepartmentId], references: [id], onDelete: Cascade)
  requestedById          String
  status                 String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requesterDeanStatus    String   @default("NONE") // NONE | PENDING | APPROVED | REJECTED - the requesting faculty's Dean
  lenderDeanStatus       String   @default("NONE") // same, for the lending faculty's Dean when it is a different faculty
  note                   String?
  decisionNote           String?
  decidedById            String?
  createdAt              DateTime @default(now())
  decidedAt              DateTime?
  allowed                TeacherLoanAllowed[]

  @@index([chairmanId, status])
  @@index([lendingDepartmentId, status])
  @@index([courseId])
  @@index([instructorId])
  @@index([requestingDepartmentId])
}

// The teachers the lending head has allowed for one request; the requester then picks one of them.
model TeacherLoanAllowed {
  id           String @id @default(cuid())
  loanId       String
  loan         TeacherLoanRequest @relation(fields: [loanId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User   @relation("LoanAllowedInstructor", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([loanId, instructorId])
  @@index([instructorId])
}

// A faculty groups several departments under one Dean (e.g. "Faculty of Computing" -> CS, SE, IT).
model Faculty {
  id          String   @id @default(cuid())
  chairmanId  String   // the institute head who owns it
  chairman    User     @relation("FacultyInstitute", fields: [chairmanId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())
  departments Department[] @relation("FacultyDepartments")
  deans       User[]   @relation("FacultyDean")
  curriculumApprovals CurriculumDeanApproval[]

  @@unique([chairmanId, name])
  @@index([chairmanId])
}

// A Dean's sign-off on one of the institute's curricula for their faculty.
model CurriculumDeanApproval {
  id           String   @id @default(cuid())
  facultyId    String
  faculty      Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  curriculumId String
  status       String   @default("APPROVED") // APPROVED | RETURNED
  note         String?
  decidedById  String
  decidedAt    DateTime @default(now())

  @@unique([facultyId, curriculumId])
  @@index([curriculumId])
}

// Several sections/batches of the same (or equivalent) course in one term form a "course team".
// One teacher of the team is its Course Lead: they finalise the exam paper, the others approve it.
// teamKey identifies the team: "g:<equivalence group id>|<term>" or "c:<course code>|<term>".
model CourseLead {
  id           String   @id @default(cuid())
  chairmanId   String
  teamKey      String
  leadId       String
  lead         User     @relation("CourseLeadUser", fields: [leadId], references: [id], onDelete: Cascade)
  assignedById String
  createdAt    DateTime @default(now())

  @@unique([chairmanId, teamKey])
  @@index([leadId])
}

// The Course Lead's paper (midterm or final question distribution) sent to the team for approval.
// Sending it again after changes raises `version` and clears earlier approvals.
model PaperSubmission {
  id           String   @id @default(cuid())
  chairmanId   String
  teamKey      String
  examType     String   // Midterm | Final
  leadCourseId String   // the lead's own course row whose paper this is
  leadId       String
  version      Int      @default(1)
  status       String   @default("SUBMITTED") // SUBMITTED | CHANGES_REQUESTED | APPROVED
  submittedAt  DateTime @default(now())
  approvedAt   DateTime?
  approvals    PaperApproval[]

  @@unique([chairmanId, teamKey, examType])
}

model PaperApproval {
  id           String   @id @default(cuid())
  submissionId String
  submission   PaperSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  status       String   // APPROVED | CHANGES_REQUESTED
  note         String?
  decidedAt    DateTime @default(now())

  @@unique([submissionId, userId])
}

// A lab manual (a Word file) for one lab session of a Lab course. The Lab Engineer uploads it; the lab's lead
// (by default the theory course's instructor) can read it and upload an updated version. Every version is kept.
model LabManual {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labNumber Int      // lab session number (one lab per week)
  title     String
  createdAt DateTime @default(now())
  versions  LabManualVersion[]

  cloId        String?  // the CLO this lab session measures (theory course CLO when the lab is imported into it)
  criteriaJson String?  @db.Text // optional rubric for this session (criteria may each carry a CLO)
  @@unique([courseId, labNumber])
}

model LabManualVersion {
  id           String   @id @default(cuid())
  manualId     String
  manual       LabManual @relation(fields: [manualId], references: [id], onDelete: Cascade)
  version      Int
  fileName     String
  fileUrl      String   @db.Text
  uploadedById String
  note         String?
  createdAt    DateTime @default(now())

  @@unique([manualId, version])
}

// A student's mark for one lab session, entered by the Lab Engineer.
model LabMark {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labNumber   Int
  score       Float
  maxScore    Float
  enteredById String
  updatedAt   DateTime @updatedAt

  levelsJson  String?  @db.Text // rubric levels chosen for this student, when the session has a rubric
  @@unique([courseId, studentId, labNumber])
  @@index([courseId])
  @@index([studentId])
}


// A request to move a teacher from one Program Lead's program to another's (same department).
// Raised by the Chairman or a Dean; it only happens once BOTH Program Leads accept.
model TeacherProgramMove {
  id                String   @id @default(cuid())
  chairmanId        String
  teacherId         String
  fromCoordinatorId String
  toCoordinatorId   String
  requestedById     String
  note              String?
  fromStatus        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  toStatus          String   @default("PENDING")
  status            String   @default("PENDING") // PENDING | APPLIED | REJECTED | CANCELLED
  createdAt         DateTime @default(now())
  decidedAt         DateTime?

  @@index([chairmanId, status])
  @@index([fromCoordinatorId])
  @@index([toCoordinatorId])
}

// Who handles a course within a department. Common courses (the same code in several programs) are given to ONE
// Program Lead; specialised courses stay with their own program's lead. Decided by the Chairman (or Institute Head).
// courseKey = lower-case trimmed course code. A lab ("<CODE>-L") follows its theory course unless it has its own row.
model CourseOwner {
  id           String   @id @default(cuid())
  chairmanId   String
  departmentId String
  courseKey    String
  ownerId      String
  ownerDepartmentId String? // the owner's own department; differs from departmentId when another department takes the course
  status       String   @default("ACCEPTED") // ACCEPTED | PENDING (waiting for the owner's department Chairman)
  assignedById String
  createdAt    DateTime @default(now())

  @@unique([chairmanId, departmentId, courseKey])
  @@index([ownerId])
}

// A faculty member's own profile: personal and contact details, next of kin, employment. Used for the faculty details reports.
model FacultyProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  photo             String?  @db.Text // small JPEG as a data URL (resized in the browser)
  designation       String?
  employmentType    String?  // Permanent | Contract | Visiting | Part-time
  employeeCode      String?  // the institute's own employee number (from the employee upload)
  dateOfJoining     DateTime?
  dateOfBirth       DateTime?
  gender            String?
  bloodGroup        String?
  phone             String?
  address           String?  @db.Text
  nextOfKinName     String?
  nextOfKinRelation String?
  nextOfKinPhone    String?
  nextOfKinAddress  String?  @db.Text
  officeHours       String?  // e.g. "Mon & Wed 2-4 pm, Room B-12"
  cnic              String?
  specialization    String?
  affiliation       String?  // visiting / adjunct faculty: their organisation
  // Checked against the documents for an accreditation visit (qualifications, experience).
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedNote      String?
  updatedAt         DateTime @updatedAt
}

// One row per education / experience / research paper / grant / project / event of a faculty member.
model FacultyRecord {
  id           String   @id @default(cuid())
  userId       String
  kind         String   // EDUCATION | EXPERIENCE | PUBLICATION | GRANT | PROJECT | EVENT
  title        String
  organisation String?
  role         String?
  startYear    Int?
  startMonth   Int?     // 1-12, work experience only
  endYear      Int?
  endMonth     Int?     // 1-12, work experience only
  amount       String?
  status       String?
  link         String?
  details      String?  @db.Text
  category     String?  // PUBLICATION: HEC category (Impact factor, W, X, Y, Other); EXPERIENCE: Academic | Industry
  authorship   String?  // PUBLICATION: First author | Co-author
  citations    Int?     // PUBLICATION: citation count
  photo        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, kind])
}

// What each computer lab holds. Filled in by the Lab Manager; drives the students-per-computer ratio.
model LabInfo {
  id               String   @id @default(cuid())
  chairmanId       String
  departmentId     String?
  name             String
  location         String?
  seats            Int      @default(0) // student workstations the room can seat
  computers        Int      @default(0) // computers installed
  computersWorking Int      @default(0) // computers in working order
  software         String?  @db.Text
  equipment        String?  @db.Text
  internetMbps     Int?
  lastAudit        DateTime?
  notes            String?  @db.Text
  updatedById      String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([chairmanId, name])
  @@index([chairmanId])
}

// Budget, spending and income by fiscal year, entered by the Institute Head.
model FinanceEntry {
  id         String   @id @default(cuid())
  chairmanId String
  fiscalYear String   // e.g. "2025-26"
  kind       String   // BUDGET | SPENT | INCOME
  category   String
  amount     Float    @default(0)
  note       String?
  updatedAt  DateTime @updatedAt

  @@unique([chairmanId, fiscalYear, kind, category])
  @@index([chairmanId])
}

// A Program Lead's log of extra-curricular activities (sports, societies, competitions, workshops ...).
model ActivityLog {
  id           String   @id @default(cuid())
  coordinatorId String
  batchId      String?
  title        String
  category     String
  activityDate DateTime
  organizer    String?
  venue        String?
  participants Int?
  description  String?  @db.Text
  outcome      String?  @db.Text
  photo        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([coordinatorId])
}

// The institute's library: one record per institute, kept by the Lab Manager or the Institute Head.
model LibraryInfo {
  id               String   @id @default(cuid())
  chairmanId       String   @unique
  seats            Int      @default(0)
  totalTitles      Int      @default(0) // printed book titles
  computingTitles  Int      @default(0) // of which in computing
  totalVolumes     Int      @default(0) // copies
  printJournals    Int      @default(0)
  ebooks           Int      @default(0)
  databases        String?  @db.Text // digital databases subscribed to (HEC digital library, IEEE, ACM ...)
  openHoursPerWeek Int?
  hasLibrarian     Boolean  @default(false)
  lastStockCheck   DateTime?
  notes            String?  @db.Text
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

// One row per kind of computer in a lab, e.g. "30 x Core i7-12700, 16 GB, 512 GB SSD".
model LabComputerSpec {
  id           String   @id @default(cuid())
  chairmanId   String
  labId        String
  quantity     Int      @default(1)
  makeModel    String?
  processor    String?
  ramGb        Int?
  storage      String?
  gpu          String?
  os           String?
  purchaseYear Int?
  notes        String?
  updatedAt    DateTime @updatedAt

  @@index([labId])
  @@index([chairmanId])
}

// Official academic calendar, set by the Institute Head (whole institute) or a Dean (own faculty).
model AcademicCalendarEntry {
  id          String   @id @default(cuid())
  chairmanId  String
  facultyId   String?  // null = applies to the whole institute
  kind        String   // SEMESTER_START | SEMESTER_END | MIDTERM | FINAL | REGISTRATION | ADMISSION | HOLIDAY | BREAK | OTHER
  title       String
  startDate   DateTime
  endDate     DateTime?
  termName    String?
  termYear    Int?
  createdById String
  createdAt   DateTime @default(now())

  @@index([chairmanId])
}

// Admission rules per degree program, set by the Dean of the faculty (scopeKey = faculty id, or "INSTITUTE" when there are no faculties).
model AdmissionCriteria {
  id               String   @id @default(cuid())
  chairmanId       String
  scopeKey         String
  degreeProgram    String
  academicYear     String?
  minPercentage    Float?
  requiredSubjects String?  @db.Text
  entryTest        String?
  minTestScore     Float?
  seats            Int?
  transferPolicy   String?  @db.Text
  otherConditions  String?  @db.Text
  updatedById      String?
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([chairmanId, scopeKey, degreeProgram])
  @@index([chairmanId])
}

// Evidence a Program Lead keeps for accreditation: industry links, internships, counselling, PEO reviews and KPIs.
model ProgramEvidence {
  id            String   @id @default(cuid())
  coordinatorId String
  area          String   // INDUSTRY | INTERNSHIP | COUNSELLING | PEO
  kind          String
  title         String
  organization  String?
  date          DateTime?
  count         Int?
  target        Float?
  actual        Float?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([coordinatorId, area])
}

// Whether a course folder (hard copy or LMS) is kept for a course.
model CourseFolder {
  id            String   @id @default(cuid())
  courseId      String   @unique
  coordinatorId String
  kept          Boolean  @default(false)
  note          String?
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([coordinatorId])
}

// A deadline set by a Dean / Chairman / Program Lead for someone below them.
model Deadline {
  id          String   @id @default(cuid())
  chairmanId  String
  assigneeId  String?  // a named person (optional): otherwise the deadline belongs to the role / the task, whoever holds it
  role        String?  // the role the work belongs to, e.g. SUBJECT_EXPERT or INSTRUCTOR of the course
  setById     String
  kind        String   // CUSTOM | CLO_SET | LECTURE_PLAN | ASSESSMENT_PLAN | PAPERS | SUBMITTED | MARKS | ATTENDANCE
  title       String
  description String?  @db.Text
  courseId    String?
  dueDate     DateTime
  completedAt DateTime?
  parentId    String?  // the higher-level deadline this one was passed on from (earlier date = slack)
  planKey     String?  // for plan tasks that are not about a course: "ONE:<key>" (one per area) or "EACH:<key>" (one per person holding the role)
  planTerm    String?  // the semester plan this belongs to, e.g. "Spring 2027"
  allCourses  Boolean  @default(false) // a standing deadline for every course in the setter's area, current and future: the per-course rows are made from it
  createdAt   DateTime @default(now())

  @@index([chairmanId])
  @@index([assigneeId])
}

// A request for action: the Institute Head (or a Dean / Chairman) asks a person to finish something found in the accreditation report;
// the person replies or marks it done, and the sender sees the answer.
model TaskRequest {
  id          String    @id @default(cuid())
  chairmanId  String
  fromId      String
  toId        String
  leadId      String?   // the Program Lead whose program the request is about
  subject     String
  area        String?
  href        String?   // the page where the work is done
  body        String    @db.Text
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN | RESPONDED | DONE | CLOSED
  response    String?   @db.Text
  respondedAt DateTime?
  doneAt      DateTime?
  remindedAt  DateTime?
  reminders   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([toId, status])
  @@index([fromId, status])
  @@index([chairmanId])
}

// A file kept as accreditation evidence (minutes, certificates, photos, reports). Stored in the database; limited to about 3 MB each.
model EvidenceFile {
  id           String   @id @default(cuid())
  chairmanId   String
  leadId       String?  // the Program Lead's program it belongs to; null = whole institute
  criterion    Int?     // NCEAC criterion 1 to 9
  title        String
  note         String?
  fileName     String
  mimeType     String
  size         Int
  data         String   @db.Text // base64
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([chairmanId])
  @@index([leadId])
}

// A meeting held, with its minutes: OMC, BOS, BPF, faculty meeting, advisory board.
model MeetingMinutes {
  id          String   @id @default(cuid())
  chairmanId  String
  leadId      String?
  kind        String   // OMC | BOS | BPF | FACULTY | IAB | OTHER
  title       String
  meetingDate DateTime
  attendees   String?  @db.Text
  decisions   String?  @db.Text
  fileName    String?
  mimeType    String?
  data        String?  @db.Text // base64 of the signed minutes, optional
  createdById String
  createdAt   DateTime @default(now())

  @@index([chairmanId, kind])
  @@index([createdById])
}

// Who changed library, finance, admission or lab figures, and when.
model ChangeLog {
  id         String   @id @default(cuid())
  chairmanId String
  area       String   // LIBRARY | FINANCE | ADMISSION | LABS
  summary    String
  byId       String
  createdAt  DateTime @default(now())

  @@index([chairmanId, area])
}

// Admitted, graduated and dropped-out students of a program, per intake year.
model OutcomeFigure {
  id            String   @id @default(cuid())
  chairmanId    String
  leadId        String
  intakeYear    Int
  admitted      Int      @default(0)
  graduated     Int      @default(0)
  graduatedOnTime Int    @default(0)
  droppedOut    Int      @default(0)
  employedOrStudying Int? // graduates employed or in further study within a year
  notes         String?
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@unique([leadId, intakeYear])
  @@index([chairmanId])
}

// A survey held for a program (students, graduating students, alumni, employers) and what it found.
model SurveyResult {
  id          String   @id @default(cuid())
  chairmanId  String
  leadId      String
  kind        String   // STUDENT | EXIT | ALUMNI | EMPLOYER | COURSE
  surveyDate  DateTime
  respondents Int      @default(0)
  invited     Int?
  avgRating   Float?   // out of 5
  findings    String?  @db.Text
  actionTaken String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([chairmanId])
}

// The accreditation scores of a program on a given day, kept so progress can be shown between visits.
model ReadinessSnapshot {
  id         String   @id @default(cuid())
  chairmanId String
  leadId     String
  label      String
  overall    Int?
  areas      String   @db.Text // JSON: [{ no, title, score }]
  takenById  String
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([chairmanId])
}


// An SE asks to change a template the OMC already approved. While approved, the SE's edit screens are locked. When the OMC approves the
// request the template reopens (a snapshot is taken); when the SE resubmits, the differences are recorded as the change log for that semester.
model TemplateChangeRequest {
  id            String    @id @default(cuid())
  courseId      String
  requestedById String
  reason        String    @db.Text
  status        String    @default("pending") // pending | approved (reopened for edits) | rejected | completed (resubmitted, changes recorded)
  omcComment    String?   @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  termLabel     String?   // "Fall 2026" — the semester this change belongs to
  beforeJson    String?   @db.Text // snapshot taken when edits were reopened
  changesJson   String?   @db.Text // list of what changed, filled in when the SE resubmits
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([courseId])
  @@index([status])
}

// Registration rules of an institute, set by the OMC (one row per Institute Head). Defaults apply until saved.
model RegistrationPolicy {
  id                    String   @id @default(cuid())
  chairmanId            String   @unique
  lowCgpaThreshold      Float    @default(2.0)  // below this a student is "low CGPA" for the limits below
  minCreditsNormal      Int      @default(12)
  maxCreditsNormal      Int      @default(18)
  maxCreditsLowCgpa     Int      @default(15)
  maxNewCoursesLowCgpa  Int      @default(2)    // courses never attempted before; retakes/repeats don't count
  maxCreditsFinalYear   Int      @default(21)   // students in the last two semesters of the program
  maxCreditsSummer      Int      @default(9)
  allowConcurrentPrereq Boolean  @default(false) // may a course be taken in the same semester as its prerequisite
  creditRules           String   @db.Text @default("[]") // JSON: [{ label, codes: ["SEN4996"], titleContains: "Final Year Project", minCredits: 95 }]
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

// An exemption from one registration rule for one student, granted by the Institute Head.
model RegistrationExemption {
  id          String    @id @default(cuid())
  chairmanId  String
  studentId   String
  rule        String    // CREDIT_REQUIREMENT | MAX_LOAD | NEW_COURSE_LIMIT | CONCURRENT_PREREQ | SELF_REGISTRATION
  courseCode  String?   // for course-specific exemptions; empty = any course
  value       Int?      // e.g. the allowed load for MAX_LOAD, or number of new courses for NEW_COURSE_LIMIT
  reason      String    @db.Text
  grantedById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([studentId])
  @@index([chairmanId])
}

// The advisor's lock on a student's degree plan: the student can no longer change it, and registration follows it.
model DegreePlanLock {
  id         String   @id @default(cuid())
  studentId  String   @unique
  lockedById String
  note       String?  @db.Text
  lockedAt   DateTime @default(now())
}

// A course offering's result: the Instructor submits it, the Chairman (Head of Department) or the Institute Head
// approves it, and from then on marks and grade cutoffs are locked. Any later change goes through a GradeChangeRequest.
model CourseResult {
  id            String    @id @default(cuid())
  courseId      String    @unique
  status        String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | RETURNED
  termName      String?
  termYear      Int?
  submittedById String?
  submittedAt   DateTime?
  decidedById   String?
  decidedAt     DateTime?
  note          String?   @db.Text // the approver's note when returning (or approving)
  summaryJson   String?   @db.Text // grades as they stood when submitted / approved
  updatedAt     DateTime  @default(now()) @updatedAt
}

// A change to one student's grade after the course result was approved: asked for by the Instructor with a reason,
// decided by the Chairman (Head of Department) or the Institute Head. An approved change overrides the computed grade.
model GradeChangeRequest {
  id            String    @id @default(cuid())
  courseId      String
  studentId     String
  oldGrade      String
  newGrade      String
  totalPct      Float?
  reason        String    @db.Text
  requestedById String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([courseId])
  @@index([studentId])
}

// A marking rubric for one assessment item (assignment, project, lab, presentation, quiz...). Each criterion carries a
// share of the item's marks, an optional CLO, and performance levels with points and a description:
// criteriaJson = [{ id, title, cloId, weight, levels: [{ label, points, descriptor }] }]
model Rubric {
  id           String   @id @default(cuid())
  instrumentId String   @unique
  courseId     String
  title        String
  criteriaJson String   @db.Text
  createdById  String
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([courseId])
}

// One student's rubric marking: levelsJson = { criterionId: levelIndex }. The item's mark (StudentMark) is worked out from it.
model RubricScore {
  id         String   @id @default(cuid())
  rubricId   String
  studentId  String
  levelsJson String   @db.Text
  comment    String?  @db.Text
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([rubricId, studentId])
  @@index([rubricId])
}

// In-app notifications (the bell in the top bar): something happened that this person should know or act on.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // e.g. RESULT, GRADE_CHANGE, ASSIGNMENT, TEMPLATE, DEADLINE, REQUEST
  title     String
  body      String?   @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// An exam period (e.g. "Midterm Fall 2026"): its days, daily time slots and rules. Its papers are scheduled into it.
model ExamSession {
  id                  String   @id @default(cuid())
  chairmanId          String
  name                String
  examType            String   // Midterm | Final
  startDate           DateTime
  endDate             DateTime
  slotsJson           String   // ["09:00-11:00", "12:00-14:00"]
  offDaysJson         String   @default("[0]") // weekdays with no exams (0 = Sunday)
  maxPerDay           Int      @default(2)     // most papers one student may sit on one day
  seatPercent         Int      @default(50)    // share of a room's capacity used for exam seating (spacing)
  invigilatorsPerRoom Int      @default(1)
  includeLabs         Boolean  @default(false)
  status              String   @default("DRAFT") // DRAFT | PUBLISHED
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([chairmanId])
}

// One course's paper in an exam session: when, and (after room allocation) which students sit in which room, and who invigilates.
// Sections of the same course code sit the same paper at the same time; each section still has its own row.
model ExamPaper {
  id               String    @id @default(cuid())
  sessionId        String
  courseId         String
  date             DateTime?
  slot             Int?
  pinned           Boolean   @default(false) // moved by hand: the generator keeps it where it is
  roomsJson        String    @default("[]")  // [{ roomId, studentIds: [] }]
  invigilatorsJson String    @default("[]")  // [{ roomId, userIds: [] }]

  @@unique([sessionId, courseId])
  @@index([sessionId])
}

// A teacher's annual appraisal: the system's figures for the year (frozen when shared) plus the reviewer's ratings and
// remarks. DRAFT (reviewer working) -> SHARED (the teacher can read it and reply) -> FINAL (signed off).
model FacultyAppraisal {
  id              String    @id @default(cuid())
  userId          String
  year            Int
  chairmanId      String
  reviewerId      String?
  status          String    @default("DRAFT") // DRAFT | SHARED | FINAL
  ratingsJson     String    @default("{}")    // { teaching: 1-5, research: 1-5, service: 1-5, conduct: 1-5 }
  studentFeedback Float?    // average student evaluation score (1-5), entered from the course evaluation forms
  overall         String?   // OUTSTANDING | VERY_GOOD | GOOD | NEEDS_IMPROVEMENT | UNSATISFACTORY
  strengths       String?   @db.Text
  improve         String?   @db.Text
  goals           String?   @db.Text
  metricsJson     String?   @db.Text // the scorecard as it stood when shared / finalised
  facultyComment  String?   @db.Text
  acknowledgedAt  DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([userId, year])
  @@index([chairmanId, year])
}

// A teacher away for one or more semesters (semester / study leave, sabbatical, long medical leave) or gone for good
// (LEFT). Their records stay; they just can't be given courses in the terms the leave covers.
// fromTerm / toTerm are term indexes (see lib/termLogic.termIndex); toTerm null = open-ended (always for LEFT).
model FacultyLeave {
  id          String    @id @default(cuid())
  userId      String
  chairmanId  String
  kind        String    // SEMESTER_LEAVE | STUDY_LEAVE | SABBATICAL | MEDICAL | LEFT
  fromTerm    Int
  toTerm      Int?
  allowDesign Boolean   @default(false) // may still build course plans as a Subject Expert while away
  note        String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())
  endedAt     DateTime? // ended early (came back)

  @@index([chairmanId])
  @@index([userId])
}

// A course handed from one instructor to another mid-way (leave, leaving): who taught which lectures stays on record.
model CourseHandover {
  id                 String   @id @default(cuid())
  courseId           String
  fromUserId         String
  toUserId           String?
  lecturesDelivered  Int      @default(0)
  lastLectureNumber  Int?
  reason             String?
  createdById        String
  createdAt          DateTime @default(now())

  @@index([courseId])
}

// A few days' leave asked by a teacher. Once approved, each class that falls in it is covered: a substitute teacher,
// a make-up class later, or cancelled.
model ShortLeave {
  id           String    @id @default(cuid())
  userId       String
  chairmanId   String
  fromDate     DateTime
  toDate       DateTime
  reason       String    @db.Text
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([chairmanId])
  @@index([userId])
}

// One class meeting during a short leave and how it is covered.
model SubstituteClass {
  id           String    @id @default(cuid())
  leaveId      String
  chairmanId   String
  date         DateTime
  entryId      String    // the timetable entry (day / time / room / section)
  courseCode   String
  courseTitle  String
  sectionLabel String
  timeLabel    String
  roomName     String
  originalId   String
  plan         String    @default("SUBSTITUTE") // SUBSTITUTE | MAKEUP | CANCEL
  substituteId String?
  status       String    @default("NEEDED") // NEEDED | ASSIGNED | ACCEPTED | DECLINED | DONE | MAKEUP_SET | CANCELLED
  makeupDate   DateTime?
  topic        String?
  note         String?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([leaveId, entryId, date])
  @@index([chairmanId, date])
  @@index([substituteId])
}

// Recognition (not a points game): badges a teacher earned in a semester — given automatically from their OBE record
// when the semester's badges are awarded, or by the Chairman / Institute Head for work the system can't see.
model RecognitionBadge {
  id          String   @id @default(cuid())
  chairmanId  String
  userId      String
  term        String   // "Fall 2026"
  badgeKey    String   // ALWAYS_ON_TIME | OBE_CHAMPION | CQI_CLOSER | COURSE_FILE_COMPLETE | CUSTOM
  title       String
  reason      String?  @db.Text
  awardedById String?  // null = awarded automatically
  createdAt   DateTime @default(now())

  @@unique([userId, term, badgeKey, title])
  @@index([chairmanId, term])
}

// A department (or institute) goal everyone can see, e.g. "100% course files by week 6".
model RecognitionGoal {
  id           String   @id @default(cuid())
  chairmanId   String
  departmentId String?  // null = whole institute
  title        String
  metric       String   // COURSE_FILES | RESULTS_APPROVED | CLOS_MAPPED | MARKS_COMPLETE | CQI_DONE
  targetPct    Int      @default(100)
  dueDate      DateTime
  createdById  String
  createdAt    DateTime @default(now())

  @@index([chairmanId])
}

// Sign-in watch (lib/inactivity.ts): when each person last used the app, each boss's limit, and alerts already sent.
model UserActivity {
  userId     String   @id
  lastSeenAt DateTime
}

model InactivityPolicy {
  id          String   @id @default(cuid())
  chairmanId  String
  bossId      String   @unique // the Institute Head's own row is the institute default (and holds the weekly days off)
  workingDays Int      @default(3) // 0 = no alerts
  offDaysJson String   @default("[0,6]") // weekdays that are not working days (0 = Sunday)
  exemptIds   String[] @default([])
  updatedAt   DateTime @updatedAt

  @@index([chairmanId])
}

model InactivityAlert {
  id          String   @id @default(cuid())
  chairmanId  String
  bossId      String
  userId      String
  lastSeenAt  DateTime // the absence this alert is about: one alert per boss, person and absence
  workingDays Int
  createdAt   DateTime @default(now())

  @@unique([bossId, userId, lastSeenAt])
  @@index([userId])
}

// A Subject Expert or Instructor asks the OMC to add a PLO to their course, or take one off (lib/ploRequests.ts).
// The PLO–Course matrix itself only changes when the OMC approves.
model PloChangeRequest {
  id            String    @id @default(cuid())
  chairmanId    String
  courseId      String
  ploId         String
  action        String    // ADD | REMOVE
  reason        String    @db.Text
  requestedById String
  requestedAs   String    // SUBJECT_EXPERT | INSTRUCTOR
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  closUnmapped  Int       @default(0) // on an approved removal: how many CLOs of the course lost this PLO
  createdAt     DateTime  @default(now())

  @@index([chairmanId, status])
  @@index([courseId])
}

// The OMC's minimum number of questions in the Midterm and Final papers, per course type (lib/examQuestions.ts).
model ExamQuestionPolicy {
  id                  String   @id @default(cuid())
  chairmanId          String
  courseType          String
  midtermMinQuestions Int      @default(0) // 0 = no rule
  finalMinQuestions   Int      @default(0)
  updatedById         String?
  updatedAt           DateTime @updatedAt

  @@unique([chairmanId, courseType])
}

// ---------------------------------------------------------------------------
// Topic-level prerequisites: "Functions" in PF is needed for "Methods" in OOP.
// Kept per program (the Program Lead who owns both courses) by course code and
// topic text, so the link applies to every batch's copy of the two courses.
model TopicPrerequisite {
  id                   String   @id @default(cuid())
  chairmanId           String
  coordinatorId        String
  prereqCourseCode     String
  prereqCourseTitle    String
  prereqTopic          String
  dependentCourseCode  String
  dependentCourseTitle String
  dependentTopic       String
  note                 String?
  createdById          String
  createdAt            DateTime @default(now())
  // STRONG: the dependent course can't be registered until the prerequisite course is passed and the topic attained
  // (or cleared through remediation). MILD / WEAK: registration is allowed and the dependent course's teacher plans
  // a review of the topic (MILD: a full review; WEAK: a short recap).
  strength             String    @default("MILD")
  // Set when the topic on either side is no longer in the course's lecture plan: the link then has no effect until
  // it is pointed at the renamed topic or removed.
  orphanedAt           DateTime?
  updatedAt            DateTime  @default(now()) @updatedAt

  @@unique([coordinatorId, prereqCourseCode, prereqTopic, dependentCourseCode, dependentTopic])
  @@index([chairmanId])
  @@index([coordinatorId, dependentCourseCode])
}

// A follow-up raised from a course's results: a prerequisite topic most students
// did not master, a planned topic that was never taught, or a topic taught and
// assessed but failed by most students. It names the course that must act (the
// dependent course, or the next offering of the same course) and records what
// was done about it (continuous quality improvement).
model TopicFollowUp {
  id               String    @id @default(cuid())
  chairmanId       String
  coordinatorId    String
  sourceCourseId   String
  sourceCourseCode String
  topic            String
  kind             String // WEAK_PREREQ | MISSED | WEAK
  studentsBelow    Int?
  studentsTotal    Int?
  targetCourseId   String?
  targetCourseCode String
  targetTopic      String?
  recommendation   String    @db.Text
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | DISMISSED
  assignedToId     String?
  actionTaken      String?   @db.Text
  actionById       String?
  actionAt         DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceCourseId, kind, topic, targetCourseCode])
  @@index([chairmanId, status])
  @@index([coordinatorId, targetCourseCode])
  @@index([assignedToId])
}

// Topic Workspace: a teacher proposes a topic to a course they do not own.
model TopicSuggestion {
  id            String    @id @default(cuid())
  chairmanId    String
  fromUserId    String
  fromCourseId  String?
  toCourseId    String
  topic         String
  subtopic      String?
  note          String?   @db.Text
  status        String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([toCourseId, status])
  @@index([fromUserId])
}

// Ideas and problems sent by any user to the platform owner (Super User).
model SystemFeedback {
  id         String   @id @default(cuid())
  userId     String
  chairmanId String?
  role       String
  category   String // IDEA | PROBLEM | USABILITY | OTHER
  title      String
  body       String   @db.Text
  pageUrl    String?
  status     String   @default("NEW") // NEW | UNDER_REVIEW | PLANNED | DONE | DECLINED
  adminReply String?  @db.Text
  recognized Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// Buildings, rooms and campus services, kept by the Facilities Manager (what PEC / NCEAC / NBEAC visits ask about).
model FacilityBuilding {
  id              String   @id @default(cuid())
  chairmanId      String
  name            String
  campus          String?
  totalAreaSqft   Float?
  coveredAreaSqft Float?
  floors          Int?
  yearBuilt       Int?
  ownership       String? // OWNED | RENTED | LEASED
  notes           String?  @db.Text
  updatedById     String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([chairmanId, name])
}

model FacilityRoom {
  id             String   @id @default(cuid())
  chairmanId     String
  buildingId     String
  name           String
  roomType       String // CLASSROOM | LAB | LECTURE_HALL | AUDITORIUM | SEMINAR | CONFERENCE | FACULTY_OFFICE | LIBRARY | ADMIN | WASHROOM | STORE | OTHER
  floor          String?
  lengthFt       Float?
  widthFt        Float?
  capacity       Int?
  multimedia     Boolean  @default(false)
  airConditioned Boolean  @default(false)
  departmentId   String?
  notes          String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([buildingId, name])
  @@index([chairmanId])
}

model FacilityService {
  id          String   @id @default(cuid())
  chairmanId  String
  kind        String // DISPENSARY | HOSTEL | TRANSPORT | CAFETERIA | SPORTS | PRAYER | PARKING | POWER_BACKUP | INTERNET | SECURITY | FIRE_SAFETY | ACCESSIBILITY | DAY_CARE | BANK | BOOKSHOP | OTHER
  name        String
  available   Boolean  @default(true)
  quantity    Int?
  capacity    Int?
  staff       Int?
  details     String?  @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([chairmanId, kind])
}

// Student clubs and societies, their office bearers and their events (Student Affairs; each society's faculty advisor keeps their own).
model StudentSociety {
  id           String   @id @default(cuid())
  chairmanId   String
  departmentId String?
  name         String
  category     String // TECHNICAL | SPORTS | LITERARY | CULTURAL | COMMUNITY | RELIGIOUS | OTHER
  advisorId    String?
  description  String?  @db.Text
  foundedYear  Int?
  societyType  String?  // ACADEMIC_SOCIETY (co-curricular) | CAMPUS_CLUB (extracurricular)
  constitutedOn DateTime?
  memberCount  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([chairmanId, name])
  @@index([advisorId])
}

model SocietyMember {
  id         String   @id @default(cuid())
  societyId  String
  studentId  String?
  name       String
  rollNumber String?
  position   String
  term       String
  createdAt  DateTime @default(now())

  @@index([societyId])
}

model SocietyEvent {
  id           String   @id @default(cuid())
  societyId    String
  chairmanId   String
  title        String
  category     String
  eventDate    DateTime
  venue        String?
  participants Int?
  guests       String?
  description  String?  @db.Text
  outcome      String?  @db.Text
  budget       Float?
  createdById  String
  createdAt    DateTime @default(now())
  // Events proposed by a society's office bearers from the student portal go through the coordinator's approval
  // (room, equipment, budget). Events entered by staff are approved as they are entered.
  status              String    @default("APPROVED") // PROPOSED | APPROVED | REJECTED | COMPLETED | CANCELLED
  proposedByStudentId String?
  roomId              String?
  startTime           String? // "14:00"
  endTime             String?
  equipment           String?
  budgetRequested     Float?
  decisionNote        String?
  decidedById         String?
  decidedAt           DateTime?

  @@index([societyId])
  @@index([chairmanId, eventDate])
}

// Accounts: fee structure per program and intake session, and scholarships / financial aid given each year.
model FeeStructure {
  id                 String   @id @default(cuid())
  chairmanId         String
  degreeProgram      String
  session            String
  admissionFee       Float    @default(0)
  tuitionPerSemester Float    @default(0)
  perCreditHour      Float?
  labFee             Float    @default(0)
  examFee            Float    @default(0)
  otherFee           Float    @default(0)
  notes              String?
  updatedById        String?
  updatedAt          DateTime @updatedAt

  @@unique([chairmanId, degreeProgram, session])
}

model ScholarshipRecord {
  id            String   @id @default(cuid())
  chairmanId    String
  fiscalYear    String
  scheme        String
  degreeProgram String?
  students      Int      @default(0)
  amount        Float    @default(0)
  notes         String?
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@index([chairmanId, fiscalYear])
}

// ---------------------------------------------------------------------------
// Final Year Projects (FYP). A department's Chairman names the FYP Head (any faculty member) and the FYP Committee;
// the Head runs one cycle per session: proposals, groups, milestones, panels, rubric evaluation, results,
// extensions. Results go to the Chairman for sign-off and then to the Examination Department and the transcript.
model FypStaff {
  id           String   @id @default(cuid())
  chairmanId   String
  departmentId String
  userId       String
  role         String // HEAD | COMMITTEE
  assignedById String
  createdAt    DateTime @default(now())

  @@unique([departmentId, userId])
  @@index([userId])
}

model FypCycle {
  id              String   @id @default(cuid())
  chairmanId      String
  departmentId    String
  title           String
  termName        String
  termYear        Int
  status          String   @default("OPEN") // OPEN | CLOSED
  courseCode      String   @default("FYP")
  courseTitle     String   @default("Final Year Project")
  creditHours     Int      @default(6)
  supervisorPct   Float    @default(30)
  internalPct     Float    @default(40)
  externalPct     Float    @default(30)
  minGroupSize    Int      @default(2)
  maxGroupSize    Int      @default(4)
  minCgpa         Float    @default(2)
  minCreditHours  Int      @default(95)
  maxApplications Int      @default(3)
  cutoffsJson     String   @db.Text
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([departmentId])
}

model FypMilestone {
  id         String   @id @default(cuid())
  cycleId    String
  kind       String // PROPOSAL_DEFENSE | MID_TERM | FINAL | THESIS | OTHER
  title      String
  dueDate    DateTime
  weightPct  Float    @default(0)
  orderIndex Int      @default(0)

  evaluatorMode String @default("PANEL") // PANEL (supervisor + panel roles) | SUPERVISOR_ONLY | SINGLE (any one evaluator)
  @@index([cycleId])
}

model FypRubricCriterion {
  id          String  @id @default(cuid())
  cycleId     String
  name        String
  description String?
  bloomLevel  String?
  ploNumber   Int?
  maxScore    Float   @default(10)
  appliesTo   String  @default("INDIVIDUAL") // INDIVIDUAL | GROUP
  orderIndex  Int     @default(0)

  @@index([cycleId])
}

model FypProposal {
  id           String    @id @default(cuid())
  cycleId      String
  proposerId   String
  title        String
  domain       String?
  abstract     String    @db.Text
  scope        String?   @db.Text
  skills       String?
  hardware     String?
  software     String?
  outcomes     String?   @db.Text
  ploNumbers   Int[]     @default([])
  societalIssue String?   @db.Text // the corporate or societal issue the project addresses
  maxGroups    Int       @default(1)
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | REVISION | REJECTED | WITHDRAWN
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cycleId, status])
  @@index([proposerId])
}

model FypGroup {
  id              String   @id @default(cuid())
  cycleId         String
  name            String
  leaderId        String
  proposalId      String?
  supervisorId    String?
  panelId         String?
  status          String   @default("FORMING") // FORMING | ACTIVE | COMPLETED
  atRisk          Boolean  @default(false)
  riskNote        String?  @db.Text
  extendedUntil   DateTime?
  publicationFlag Boolean  @default(false)
  patentFlag      Boolean  @default(false)
  incubatorFlag   Boolean  @default(false)
  flagNote        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stall      String?  // open house: stall / room number
  @@index([cycleId])
  @@index([supervisorId])
  @@index([panelId])
}

model FypGroupMember {
  id        String   @id @default(cuid())
  cycleId   String
  groupId   String
  studentId String
  status    String   @default("INVITED") // INVITED | JOINED
  createdAt DateTime @default(now())

  @@unique([cycleId, studentId])
  @@index([groupId])
}

model FypApplication {
  id          String    @id @default(cuid())
  groupId     String
  proposalId  String
  message     String?   @db.Text
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([groupId, proposalId])
  @@index([proposalId, status])
}

model FypPanel {
  id        String    @id @default(cuid())
  cycleId   String
  name      String
  domain    String?
  venue     String?
  sessionAt DateTime?
  createdAt DateTime  @default(now())

  @@index([cycleId])
}

model FypPanelMember {
  id         String  @id @default(cuid())
  panelId    String
  userId     String?
  externalId String?
  role       String // CHAIR | INTERNAL | EXTERNAL

  @@index([panelId])
  @@index([userId])
  @@index([externalId])
}

model FypExternal {
  id           String   @id @default(cuid())
  chairmanId   String
  cycleId      String
  name         String
  email        String
  organization String?
  designation  String?
  expertise    String?
  tokenHash    String   @unique
  expiresAt    DateTime
  createdById  String
  createdAt    DateTime @default(now())

  @@index([cycleId])
}

model FypScore {
  id            String   @id @default(cuid())
  groupId       String
  milestoneId   String
  criterionId   String
  studentId     String
  evaluatorKey  String // a user id, or "ext:<FypExternal id>"
  evaluatorRole String // SUPERVISOR | INTERNAL | EXTERNAL
  score         Float
  updatedAt     DateTime @updatedAt

  @@unique([milestoneId, criterionId, studentId, evaluatorKey])
  @@index([groupId])
}

model FypEvaluation {
  id             String   @id @default(cuid())
  groupId        String
  milestoneId    String
  evaluatorKey   String
  evaluatorRole  String
  evaluatorName  String
  comments       String?  @db.Text
  recommendation String   @default("ON_TRACK") // ON_TRACK | AT_RISK
  updatedAt      DateTime @updatedAt

  @@unique([groupId, milestoneId, evaluatorKey])
}

model FypResult {
  id               String    @id @default(cuid())
  cycleId          String
  groupId          String
  studentId        String
  totalPct         Float
  grade            String
  gpaPoints        Float?
  ploJson          String    @db.Text
  breakdownJson    String    @db.Text
  status           String    @default("CONSOLIDATED") // CONSOLIDATED | APPROVED | RETURNED | HELD
  note             String?   @db.Text
  consolidatedById String
  consolidatedAt   DateTime  @default(now())
  approvedById     String?
  approvedAt       DateTime?
  submittedAt      DateTime?

  @@unique([cycleId, studentId])
  @@index([groupId])
}

model FypExtension {
  id          String    @id @default(cuid())
  groupId     String
  kind        String // TWO_WEEKS | FOUR_WEEKS | SEMESTER
  previousDue DateTime?
  newDueDate  DateTime
  reason      String    @db.Text
  followUpAt  DateTime?
  grantedById String
  createdAt   DateTime  @default(now())

  @@index([groupId])
}

model FypRequisition {
  id          String    @id @default(cuid())
  groupId     String
  kind        String // FUNDING | HARDWARE | LAB_EQUIPMENT | REIMBURSEMENT
  item        String
  details     String?   @db.Text
  amount      Float?
  sponsor     String?
  status      String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | ISSUED | REIMBURSED
  requestedBy String
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([groupId])
}

model FypArtifact {
  id            String   @id @default(cuid())
  groupId       String
  kind          String // THESIS_DRAFT | SIMILARITY_REPORT | REPOSITORY | DEMO_VIDEO | OTHER
  url           String
  similarityPct Float?
  note          String?
  addedBy       String
  createdAt     DateTime @default(now())

  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Prerequisite review modules, remediation, course tools, the textbook pool and engagement points.

// A MILD / WEAK topic prerequisite asks the dependent course's teacher to review the prerequisite topic; this records
// where in their plan they do it.
model PrereqReviewPlan {
  id            String   @id @default(cuid())
  linkId        String
  courseId      String // the dependent course offering
  lectureNumber Int?
  status        String   @default("PLANNED") // PLANNED | DONE
  note          String?
  byId          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([linkId, courseId])
  @@index([courseId])
}

// Remediation the OMC plans for students who did not attain topics / CLOs of a course: a dedicated tutorial, or
// sitting the relevant lectures of a junior offering. A micro-assessment afterwards updates their attainment.
// Students pay a small fee instead of retaking the course; the instructor is paid a share of the fees collected.
model RemediationPlan {
  id                 String    @id @default(cuid())
  chairmanId         String
  coordinatorId      String
  courseCode         String
  courseTitle        String
  topics             String[]
  cloCodes           String[]
  kind               String // TUTORIAL | JUNIOR_SITTING
  title              String
  instructorId       String?
  hostCourseId       String? // JUNIOR_SITTING: the junior offering whose lectures are attended
  lectureNumbers     Int[]
  schedule           String?   @db.Text
  startDate          DateTime?
  feePerStudent      Float     @default(0)
  instructorSharePct Float     @default(70)
  assessmentTitle    String?
  status             String    @default("PLANNED") // PLANNED | RUNNING | COMPLETED | CANCELLED
  payoutAmount       Float?
  payoutAt           DateTime?
  payoutById         String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([chairmanId, status])
  @@index([instructorId])
}

model RemediationEnrollment {
  id             String    @id @default(cuid())
  planId         String
  studentId      String
  sourceCourseId String? // the student's attempt of the course
  status         String    @default("ENROLLED") // ENROLLED | CLEARED | NOT_CLEARED | WITHDRAWN
  feeAmount      Float     @default(0)
  feeStatus      String    @default("UNPAID") // UNPAID | PAID | WAIVED
  receiptNo      String?
  paidAt         DateTime?
  feeById        String?
  scorePct       Float?
  assessedAt     DateTime?
  assessedById   String?
  beforeJson     String?   @db.Text // transcript attainment before the micro-assessment updated it
  createdAt      DateTime  @default(now())

  @@unique([planId, studentId])
  @@index([studentId])
}

// Software, languages, environments and tools an instructor uses in a course.
model CourseTool {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  category  String // LANGUAGE | IDE | SOFTWARE | LIBRARY | PLATFORM | HARDWARE | OTHER
  version   String?
  addedById String
  createdAt DateTime @default(now())

  @@unique([courseId, name])
  @@index([courseId])
}

// The shared textbook pool: books used for HEC-standard courses by the institutes on the platform (and in the HEC
// curriculum documents), matched to courses by their standard title.
model Textbook {
  id          String   @id @default(cuid())
  title       String
  authors     String?
  edition     String?
  publisher   String?
  year        Int?
  isbn        String?
  normKey     String   @unique
  subjects    String[]
  fromHec     Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
}

model CourseTextbook {
  id         String   @id @default(cuid())
  courseId   String
  textbookId String
  kind       String   @default("TEXT") // TEXT | REFERENCE
  addedById  String
  createdAt  DateTime @default(now())

  @@unique([courseId, textbookId])
  @@index([textbookId])
}

// The librarian's procurement record for one book in one term.
model LibraryRequisition {
  id          String   @id @default(cuid())
  chairmanId  String
  term        String
  textbookId  String
  inStock     Int      @default(0)
  ordered     Int      @default(0)
  received    Int      @default(0)
  status      String   @default("PENDING") // PENDING | ORDERED | RECEIVED | NOT_NEEDED
  note        String?
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([chairmanId, term, textbookId])
}

// Co-curricular engagement points: attending, taking part in, organizing or winning society events, and holding a
// society office. dedupeKey stops the same award being given twice.
model EngagementRecord {
  id          String   @id @default(cuid())
  chairmanId  String
  studentId   String
  societyId   String?
  eventId     String?
  kind        String // ATTENDED | PARTICIPATED | ORGANIZED | WON | LEADERSHIP | OTHER
  points      Int
  term        String?
  note        String?
  dedupeKey   String   @unique
  awardedById String
  createdAt   DateTime @default(now())

  @@index([chairmanId])
  @@index([studentId])
  @@index([eventId])
}

// A topic taught in two courses of a program, judged by the curriculum team: an intentional progression (the later
// course builds on it) or an accidental duplication (to be removed from one of them).
model TopicOverlapReview {
  id            String   @id @default(cuid())
  coordinatorId String
  codeA         String
  codeB         String
  topicKey      String
  topicA        String
  topicB        String
  verdict       String // PROGRESSION | DUPLICATION
  note          String?
  byId          String
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([coordinatorId, codeA, codeB, topicKey])
  @@index([coordinatorId])
}

// ---------------------------------------------------------------------------
// Accreditation (NBEAC SAR) data that has no other home in the system.
//
// SarProfile: the institute's ("HEI") or a business school's (department id) profile, kept as one JSON document edited
// section by section (general information, contacts, vision & mission, QEC, ORIC, workload policy, facility details,
// SAR narratives). AccreditationRecord: a register of typed records — policies and manuals, statutory bodies, strategic
// plans, audits, cases, counselling, MOUs, research centres, … The fields of each section and record kind are defined
// in lib/sarRegistry.ts.
model SarProfile {
  id          String   @id @default(cuid())
  chairmanId  String
  scopeKey    String // "HEI" or a department id
  dataJson    String   @db.Text
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([chairmanId, scopeKey])
}

model AccreditationRecord {
  id           String    @id @default(cuid())
  chairmanId   String
  departmentId String? // null = the whole institute
  kind         String
  title        String
  recordDate   DateTime?
  year         String? // "2025", "2025-26", "Fall 2025"
  dataJson     String    @db.Text
  fileName     String?
  mimeType     String?
  fileData     String?   @db.Text // base64, optional
  createdById  String
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([chairmanId, kind])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------------------------------- Help center
// The built-in manual and FAQ live in code (lib/help/content.ts). These tables hold what an institute adds itself,
// the help-desk requests people raise when the answers don't cover their problem, and the signals used to improve it.

/// An institute's own guide or FAQ entry (chairmanId null = written by the platform team for every institute).
model HelpArticle {
  id             String   @id @default(cuid())
  chairmanId     String?
  kind           String // GUIDE | FAQ
  category       String
  title          String
  summary        String   @db.Text
  stepsJson      String?  @db.Text // JSON string[]
  whoCan         String?  @db.Text
  affects        String?  @db.Text
  roles          String   @default("") // comma-separated audience roles; "" = all staff, STUDENT = the student portal
  pages          String   @default("") // comma-separated page prefixes where it is suggested
  keywords       String   @default("")
  href           String?
  published      Boolean  @default(true)
  sourceTicketId String?
  createdById    String
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([chairmanId])
}

/// A help-desk request, routed to the people who can answer it (recipientIds, a JSON array of user ids).
model HelpTicket {
  id                 String    @id @default(cuid())
  chairmanId         String?
  desk               String
  subject            String
  body               String    @db.Text
  query              String?
  page               String?
  status             String    @default("OPEN") // OPEN | ANSWERED | RESOLVED | CLOSED
  requesterUserId    String?
  requesterStudentId String?
  requesterName      String
  requesterRole      String
  recipientIds       String    @db.Text
  assignedToId       String?
  lastActivityAt     DateTime  @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([chairmanId, status])
  @@index([requesterUserId])
  @@index([requesterStudentId])
}

model HelpTicketMessage {
  id              String   @id @default(cuid())
  ticketId        String
  authorUserId    String?
  authorStudentId String?
  authorName      String
  body            String   @db.Text
  createdAt       DateTime @default(now())

  @@index([ticketId])
}

/// "Was this helpful?" — one vote per person per article, changeable.
model HelpFeedback {
  id         String   @id @default(cuid())
  chairmanId String?
  articleKey String
  helpful    Boolean
  role       String
  voterKey   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([articleKey, voterKey])
  @@index([chairmanId])
}

/// Searches that found nothing, so the Institute Head can see which answers are missing (no person is recorded).
model HelpSearchLog {
  id         String   @id @default(cuid())
  chairmanId String?
  role       String
  query      String
  results    Int
  page       String?
  createdAt  DateTime @default(now())

  @@index([chairmanId, createdAt])
}

// ---------------------------------------------------------------------------------------------------- QR attendance
// A live attendance session for one lecture: the instructor's screen shows a QR code that changes every few seconds
// (an AES-GCM token made with the session's own key, which never leaves the server). Students scan it to check in;
// the result is written to AttendanceRecord like hand-marked attendance.

model AttendanceSession {
  id             String    @id @default(cuid())
  courseId       String
  lectureRowId   String
  instructorId   String
  chairmanId     String?
  keyHex         String
  rotateSeconds  Int       @default(12)
  presentMinutes Int       @default(10)
  lateMinutes    Int       @default(25)
  requireLogin   Boolean   @default(true)
  sameNetwork    Boolean   @default(false)
  networkKey     String?
  checkLocation  Boolean   @default(false)
  lat            Float?
  lng            Float?
  radiusM        Int       @default(150)
  status         String    @default("OPEN") // OPEN | CLOSED
  startedAt      DateTime  @default(now())
  closesAt       DateTime
  closedAt       DateTime?
  closedById     String?
  absentMarked   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([courseId])
  @@index([instructorId, status])
  @@index([status, closesAt])
}

/// One student in one session: how and when they were marked, and from which device.
model AttendanceCheckin {
  id                String   @id @default(cuid())
  sessionId         String
  studentId         String
  status            String // PRESENT | LATE | ABSENT | LEAVE
  method            String // QR | ROLL | MANUAL | AUTO_ABSENT
  at                DateTime @default(now())
  ip                String?
  deviceId          String?
  userAgent         String?
  distanceM         Int?
  note              String?
  byUserId          String?
  duplicateAttempts Int      @default(0)
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId, deviceId])
}

/// A student below the institute's minimum attendance in a course (kept so the Program Lead and advisor are told once).
model AttendanceFlag {
  id             String    @id @default(cuid())
  studentId      String
  courseId       String
  chairmanId     String?
  status         String // SHORT | RECOVERED
  percentage     Float
  firstFlaggedAt DateTime  @default(now())
  lastCheckedAt  DateTime  @default(now())
  notifiedAt     DateTime?
  clearedAt      DateTime?

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([chairmanId, status])
}

// ---------------------------------------------------------------------------------------------------- Accreditation governance
// Each program is bound to one council (DepartmentProgram.accreditationBody). An accreditation visit (cycle) turns that
// council's requirements into tasks (lib/accreditation/catalogue.ts) that a Dean or Chairman assigns; the assignee
// verifies the data the system fills in, adds what is missing and signs off.

/// The thresholds an institute applies to the programs of one council (null = the default, or the institute's own setting).
model AccreditationStandard {
  id                     String   @id @default(cuid())
  chairmanId             String
  body                   String // NCEAC | NBEAC | HEC
  cloPassPct             Int?
  ploPassPct             Int?
  ploTargetPct           Int?
  maxStudentsPerComputer Float?
  maxStudentFacultyRatio Int?
  minFullTimeFaculty     Int?
  minPhdFaculty          Int?
  minCreditHours         Int?
  maxFacultyLoadCh       Int?
  maxClassSize           Int?
  updatedById            String?
  updatedAt              DateTime @default(now()) @updatedAt

  @@unique([chairmanId, body])
}

/// An accreditation visit being prepared for one program.
model AccreditationCycle {
  id           String    @id @default(cuid())
  chairmanId   String
  departmentId String?
  leadId       String
  program      String
  body         String
  title        String
  visitDate    DateTime?
  status       String    @default("OPEN") // OPEN | CLOSED
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([chairmanId, status])
  @@index([leadId])
}

/// One requirement of the council for that visit, assigned to one person at a time.
model AccreditationTask {
  id            String    @id @default(cuid())
  cycleId       String
  code          String
  status        String    @default("OPEN") // OPEN | ASSIGNED | SUBMITTED | RETURNED | APPROVED
  assigneeId    String?
  assignedById  String?
  assignedAt    DateTime?
  dueDate       DateTime?
  accessUntil   DateTime?
  dataJson      String    @default("{}") @db.Text
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([cycleId, code])
  @@index([assigneeId, status])
}

model AccreditationTaskFile {
  id           String   @id @default(cuid())
  taskId       String
  title        String
  fileName     String
  mimeType     String
  size         Int
  data         String   @db.Text
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([taskId])
}

/// Who assigned, reassigned, revoked, submitted, returned or approved a task, and when.
model AccreditationTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  action    String
  byId      String
  toId      String?
  note      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// How much each course counts toward a PLO of its batch (lib/ploWeights.ts). Per PLO the weights of its courses total
// 100. No rows for a PLO = equal split among the courses the OMC mapped to it.
model CoursePloWeight {
  id          String   @id @default(cuid())
  batchId     String
  ploId       String
  courseId    String
  weightPct   Float
  source      String   @default("MANUAL") // MANUAL | SUGGESTED | EQUAL
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([courseId, ploId])
  @@index([batchId])
  @@index([ploId])
}

// How much each PLO counts toward each PEO of a program (PEOs live in ProgramProfile.peos, in order). Per PEO the
// weights of its PLOs total 100; a PLO with no row does not serve that PEO. Matched to every batch by PLO number.
model ProgramPeoWeight {
  id            String   @id @default(cuid())
  coordinatorId String
  degreeProgram String
  peoIndex      Int      // 0-based position in ProgramProfile.peos
  ploNumber     Int
  weightPct     Float
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@unique([coordinatorId, degreeProgram, peoIndex, ploNumber])
  @@index([coordinatorId, degreeProgram])
}

// Pinned menu links ("My work") per person; the menu falls back to the role's default list when there is no row.
model UserNavPref {
  userId    String   @id
  pinsJson  String   @default("[]")
  updatedAt DateTime @default(now()) @updatedAt
}

// Organisation chart drawn by the Institute Head in the university's own words. Each box may grant one system role
// (role) with a scope (faculty / department / program) and may also cover duties of missing levels (coversJson).
model OrgPosition {
  id           String   @id @default(cuid())
  chairmanId   String
  parentId     String?
  title        String
  role         String   @default("NONE") // NONE | DEAN | HEAD_OF_DEPARTMENT | DEPARTMENT_COORDINATOR | PROGRAM_LEAD | OMC | COURSE_ASSIGNER
  facultyId    String?
  departmentId String?
  program      String?
  holderId     String?
  coversJson   String   @default("[]")
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([chairmanId])
  @@index([parentId])
  @@index([holderId])
}

// Who held each position, from when to when.
model OrgPositionLog {
  id         String   @id @default(cuid())
  positionId String
  title      String
  userId     String
  action     String   // ASSIGNED | REMOVED
  byId       String
  at         DateTime @default(now())

  @@index([positionId])
}

// OBE learning: best score per lesson / course practice ("lesson:<key>" or "course:<masterCourseId>").
model ObeProgress {
  id        String   @id @default(cuid())
  userId    String
  key       String
  score     Int
  total     Int
  passed    Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, key])
}

// Extra practice questions added by the OMC / Institute Head (chairmanId) or the Super User (chairmanId null = everyone).
model ObeQuestion {
  id             String   @id @default(cuid())
  chairmanId     String?
  masterCourseId String?
  courseCode     String?
  prompt         String   @db.Text
  optionsJson    String   @db.Text
  answer         Int
  explanation    String?  @db.Text
  createdById    String
  createdAt      DateTime @default(now())

  @@index([masterCourseId])
  @@index([chairmanId])
}

// OBE Assistant chat (for the daily limit and so the OMC can see common questions).
model ObeChatLog {
  id         String   @id @default(cuid())
  userId     String
  chairmanId String
  courseId   String?
  question   String   @db.Text
  answer     String   @db.Text
  at         DateTime @default(now())

  @@index([userId, at])
  @@index([chairmanId])
}

// How a batch's PLO attainment changed when one course's result was approved (before = without the course, after = with it).
model PloChangeLog {
  id         String   @id @default(cuid())
  batchId    String
  courseId   String   @unique
  courseCode String
  approvedAt DateTime
  deltasJson String   @db.Text // [{ plo: number, before: number|null, after: number|null }]
  createdAt  DateTime @default(now())

  @@index([batchId])
}

// Project / lab groups of a course: mark the group once, change individual students when needed.
model WorkGroup {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  title       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model WorkGroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String

  @@unique([groupId, studentId])
  @@index([studentId])
}

// A presentation can have its own panel per group (different size per milestone).
model FypMilestonePanel {
  id          String @id @default(cuid())
  milestoneId String
  groupId     String
  panelId     String

  @@unique([milestoneId, groupId])
}

// Students answer each panel remark; the next panel sees remark and reply.
model FypRemarkReply {
  id           String   @id @default(cuid())
  evaluationId String
  studentId    String
  text         String   @db.Text
  addressed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([evaluationId])
}

// Supervisor meetings: attendance, tasks with follow-up at the next meeting, feedback and the next date.
model FypMeeting {
  id          String    @id @default(cuid())
  groupId     String
  heldAt      DateTime
  nextAt      DateTime?
  feedback    String?   @db.Text
  createdById String
  createdAt   DateTime  @default(now())

  @@index([groupId])
}

model FypMeetingAttendance {
  id        String  @id @default(cuid())
  meetingId String
  studentId String
  present   Boolean

  @@unique([meetingId, studentId])
}

model FypMeetingTask {
  id         String    @id @default(cuid())
  meetingId  String
  groupId    String
  studentId  String?
  text       String    @db.Text
  status     String    @default("OPEN") // OPEN | DONE | PARTIAL | NOT_DONE
  reviewedAt DateTime?

  @@index([groupId])
}

// Open house: projects an external evaluator chose to visit.
model FypShowcasePick {
  id         String   @id @default(cuid())
  externalId String
  groupId    String
  createdAt  DateTime @default(now())

  @@unique([externalId, groupId])
}

// A student's CV, built from their profile; shown to industry only once approved and published.
model StudentCv {
  studentId    String   @id
  dataJson     String   @db.Text
  showCgpa     Boolean  @default(false)
  published    Boolean  @default(false)
  status       String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | CHANGES
  reviewerNote String?  @db.Text
  reviewedById String?
  updatedAt    DateTime @default(now()) @updatedAt
}

// FYP plans: the FYP Head's year plan (groupId null: open house and other cycle tasks) and each group's own project plan.
model FypPlanTask {
  id          String   @id @default(cuid())
  cycleId     String
  groupId     String?
  title       String
  category    String   @default("GENERAL") // GENERAL | OPEN_HOUSE | GROUP
  ownerId     String?
  ownerText   String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("TODO") // TODO | IN_PROGRESS | DONE
  orderIndex  Int      @default(0)
  durationDays Int?    // working days needed; the end date follows from it (holidays and weekends skipped)
  dependsJson  String? // ids of tasks that must finish first
  fixedStart   Boolean @default(false) // the start date is fixed (otherwise it follows its dependencies)
  createdById String
  createdAt   DateTime @default(now())

  @@index([cycleId])
  @@index([groupId])
}

// Open house logistics: interview rooms, ushers, refreshments, printing (per group posters) and other items.
model FypOpenHouseItem {
  id        String    @id @default(cuid())
  cycleId   String
  kind      String    // INTERVIEW | USHER | REFRESHMENT | PRINT | OTHER
  title     String
  groupId   String?
  ownerId   String?
  ownerText String?
  room      String?
  startAt   DateTime?
  endAt     DateTime?
  qty       Int?
  vendor    String?
  status    String    @default("PLANNED")
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([cycleId])
}

// ===================== University-wide planner and ERP modules =====================
// A plan of any office (admissions campaign, convocation, accreditation visit …); its tasks live in FypPlanTask with cycleId = plan id.
model UniPlan {
  id          String   @id @default(cuid())
  chairmanId  String
  title       String
  area        String?
  ownerId     String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([chairmanId])
}

model PayStructure {
  userId         String   @id
  basic          Float    @default(0)
  allowancesJson String   @default("[]")
  deductionsJson String   @default("[]")
  taxPct         Float    @default(0)
  bank           String?
  account        String?
  updatedAt      DateTime @default(now()) @updatedAt
}

model PayrollRun {
  id          String   @id @default(cuid())
  chairmanId  String
  month       String
  status      String   @default("DRAFT")
  totalsJson  String   @default("{}")
  createdById String
  createdAt   DateTime @default(now())

  @@unique([chairmanId, month])
}

model Payslip {
  id         String @id @default(cuid())
  runId      String
  userId     String
  gross      Float
  deductions Float
  tax        Float
  net        Float
  linesJson  String @db.Text

  @@index([runId])
}

model FeeInvoice {
  id          String   @id @default(cuid())
  chairmanId  String
  studentId   String
  termName    String
  termYear    Int
  linesJson   String   @db.Text
  amount      Float
  discount    Float    @default(0)
  fine        Float    @default(0)
  paid        Float    @default(0)
  dueDate     DateTime
  status      String   @default("UNPAID")
  createdAt   DateTime @default(now())

  @@index([chairmanId])
  @@index([studentId])
}

model FeePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Float
  method       String
  reference    String?
  paidAt       DateTime @default(now())
  receivedById String

  @@index([invoiceId])
}

model LedgerAccount {
  id         String @id @default(cuid())
  chairmanId String
  code       String
  name       String
  type       String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE

  @@unique([chairmanId, code])
}

model JournalEntry {
  id          String   @id @default(cuid())
  chairmanId  String
  date        DateTime
  memo        String
  source      String?
  sourceId    String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([chairmanId, date])
}

model JournalLine {
  id        String @id @default(cuid())
  entryId   String
  accountId String
  debit     Float  @default(0)
  credit    Float  @default(0)

  @@index([entryId])
  @@index([accountId])
}

model AdmissionLead {
  id           String    @id @default(cuid())
  chairmanId   String
  name         String
  phone        String?
  email        String?
  city         String?
  program      String?
  source       String?
  stage        String    @default("INQUIRY")
  score        Float?
  ownerId      String?
  nextFollowUp DateTime?
  notes        String?   @db.Text
  studentId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([chairmanId, stage])
}

model LeadActivity {
  id     String   @id @default(cuid())
  leadId String
  kind   String
  text   String   @db.Text
  byId   String
  at     DateTime @default(now())

  @@index([leadId])
}

model Vendor {
  id         String  @id @default(cuid())
  chairmanId String
  name       String
  phone      String?
  email      String?
  ntn        String?
  address    String?

  @@index([chairmanId])
}

model StockItem {
  id           String @id @default(cuid())
  chairmanId   String
  code         String
  name         String
  category     String?
  unit         String @default("pcs")
  location     String?
  qty          Float  @default(0)
  reorderLevel Float  @default(0)
  unitCost     Float  @default(0)

  @@unique([chairmanId, code])
}

model StockMove {
  id     String   @id @default(cuid())
  itemId String
  qty    Float
  kind   String // RECEIPT | ISSUE | ADJUST
  ref    String?
  byId   String
  at     DateTime @default(now())

  @@index([itemId])
}

model PurchaseRequest {
  id            String    @id @default(cuid())
  chairmanId    String
  requestedById String
  title         String
  linesJson     String    @db.Text // [{ itemId?, name, qty, unitCost }]
  total         Float     @default(0)
  status        String    @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | ORDERED | RECEIVED
  vendorId      String?
  poNumber      String?
  decidedById   String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([chairmanId, status])
}
