// ============================================================================
// OBE / Curriculum / Accreditation Platform — Core Data Model (MVP)
// Lineage backbone: Super User -> Chairman -> Program Coordinator -> Faculty
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_USER
  CHAIRMAN
  PROGRAM_COORDINATOR
  SUBJECT_EXPERT
  INSTRUCTOR
  OMC
  COURSE_ASSIGNER
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String   // Argon2id hash — never plaintext
  name               String
  role               UserRole
  department         String?

  // Self-relation: who created / manages this account (Super User -> Chairman ->
  // Program Coordinator -> Faculty). Keeps the org chain queryable without a
  // separate institution model, which can be layered in later.
  managedById        String?
  managedBy          User?    @relation("UserManagement", fields: [managedById], references: [id])
  managedUsers       User[]   @relation("UserManagement")

  mustChangePassword Boolean  @default(false)
  mfaEnabled         Boolean  @default(false)
  mfaSecret          String?
  mfaBackupCodes     String?  // JSON array of hashed one-time backup codes
  instituteName      String? // set by Super User only, per-Chairman (this is a multi-tenant SaaS — each paying institution has its own)
  instituteLogo      String? @db.Text // base64 data URI, set by Super User only, per-Chairman
  normalLoad         Int      @default(3)  // standard course/lab-section load, set by Coordinator at onboarding
  specialization     String?  // e.g. "Software Engineering", "AI", "Networks" — set by Coordinator, used to suggest a good fit for elective/specialization courses
  secondaryRole      String?  // set on a SUBJECT_EXPERT to also let them be assigned/act as an INSTRUCTOR (same account, same or different course) — a dual-capable person picks which one to act as at login
  maxDegreePrograms  Int?     // set by Super User on a CHAIRMAN account — the number of distinct Degree Programs their institution is licensed for; null = unlimited
  externalLoadCount  Int      @default(0)  // load from courses taught elsewhere (e.g. MS-level) not tracked in this system
  externalLoadNote   String?               // e.g. "2 courses at MS level"
  isActive           Boolean  @default(true)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  courses            Course[] @relation("CourseCoordinator")
  seCourses          Course[] @relation("CourseSubjectExpert")
  teachingCourses    Course[] @relation("CourseInstructor")
  sectionAssignments CourseSectionAssignment[] @relation("SectionInstructor")
  groupSectionAssignments GroupSectionAssignment[] @relation("GroupSectionInstructor")
  equivalenceGroups  CourseEquivalenceGroup[] @relation("EquivalenceChairman")
  plos               PLO[]    @relation("PloCoordinator")
  batches            Batch[]  @relation("BatchCoordinator")
  currentTerm        CurrentTerm? @relation("CurrentTermCoordinator")
  holidays           Holiday[]    @relation("HolidayCoordinator")
  classDayModes      ClassDayMode[] @relation("ClassDayModeCoordinator")
  cqiRecords         CqiRecord[]  @relation("CqiChairman")
  semesterDates      SemesterDates[] @relation("SemesterDatesCoordinator")
  gradingScale       GradingScale[]  @relation("GradingScaleCoordinator")
  reportAccessRules  ReportAccessRule[] @relation("ReportAccessChairman")
  programProfiles    ProgramProfile[] @relation("ProgramProfileCoordinator")
  alumni             Alumni[] @relation("AlumniCoordinator")
  employers          Employer[] @relation("EmployerCoordinator")
  surveyTemplates    SurveyTemplate[] @relation("SurveyTemplateCoordinator")
  weightPolicies     WeightPolicy[] @relation("WeightPolicyChairman")
  auditLogs          AuditLog[]

  @@index([managedById])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  mfaVerified Boolean @default(true) // false only while an MFA-enabled user's login is pending code entry
  activeRole  String? // which role a dual-capable person (Subject Expert who can also Instruct) chose for this session

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  @@index([userId])
}

// A cohort/intake — e.g. "BS Computer Science, Fall 2025". Different batches
// can follow different schemes of studies, so the same HEC curriculum can be
// (re-)imported independently for each one.
model Batch {
  id             String   @id @default(cuid())
  coordinatorId  String
  coordinator    User     @relation("BatchCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram  String   // e.g. "BS Computer Science"
  batchName      String   // e.g. "Fall 2025"
  startTerm      String   @default("Fall")   // "Fall" | "Spring" — which term this batch's Semester 1 falls in
  startYear      Int      @default(2025)
  studentCount   Int      @default(0) // current active student count — editable each semester as students join/leave
  createdAt      DateTime @default(now())

  courses        Course[]
  plos           PLO[]    @relation("BatchPlos")
  cqiRecords     CqiRecord[]
  students       Student[]

  @@unique([coordinatorId, degreeProgram, batchName])
  @@index([coordinatorId])
}

// The single "what term is it right now" setting per coordinator/program —
// updating this drives which batch is in which semester automatically.
model CurrentTerm {
  id            String   @id @default(cuid())
  coordinatorId String   @unique
  coordinator   User     @relation("CurrentTermCoordinator", fields: [coordinatorId], references: [id])
  termName      String   // "Fall" | "Spring"
  year          Int
  updatedAt     DateTime @updatedAt
}

// OMC-defined institution-wide pass/fail threshold for CLO and PLO
// attainment — how much of a CLO/PLO's max weighted marks a student needs
// to count as having "passed" it. Defaults to 50% for both if never set.
model PassingCriteria {
  id            String @id @default(cuid())
  chairmanId    String @unique
  cloPassingPct Int    @default(50)
  ploPassingPct Int    @default(50)
}

// OMC-defined min/max assessment weight ranges per course type. A Subject
// Expert's weights must fall within these; if not, a WeightExceptionRequest
// is created instead of saving directly.
model WeightPolicy {
  id            String   @id @default(cuid())
  chairmanId    String
  chairman      User     @relation("WeightPolicyChairman", fields: [chairmanId], references: [id])
  updatedById   String?  // which OMC member last changed this policy
  courseType    String   // Core | Elective | Lab | IDS | General Education | Capstone Project | Field Experience
  assignmentMin Int      @default(0)
  assignmentMax Int      @default(100)
  assignmentMinCount Int @default(1) // minimum number of assignments to be conducted
  quizMin       Int      @default(0)
  quizMax       Int      @default(100)
  quizMinCount  Int      @default(1) // minimum number of quizzes to be conducted
  projectMin    Int      @default(0)
  projectMax    Int      @default(100)
  projectMinCount Int    @default(0)
  labMin        Int      @default(0)
  labMax        Int      @default(100)
  labMinCount   Int      @default(0)
  midtermMin    Int      @default(0)
  midtermMax    Int      @default(100)
  midtermMinCount Int    @default(1)
  finalMin      Int      @default(0)
  finalMax      Int      @default(100)
  finalMinCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chairmanId, courseType])
  @@index([chairmanId])
}

// A Subject Expert's proposed weights that fall outside the policy range,
// pending OMC approval. Only the latest request per course is kept.
model WeightExceptionRequest {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  source        String   @default("SE") // "SE" | "INSTRUCTOR" — which one's proposed weights this is
  requestedById String
  assignmentPct Int
  quizPct       Int
  projectPct    Int
  labPct        Int
  midtermPct    Int
  finalPct      Int
  status        String   @default("pending") // pending | approved | rejected
  omcComment    String?  @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([courseId, source])
  @@index([courseId])
}

// Which faculty member teaches how many sections of a given (offered)
// course — the source of truth for the Course Assigner's load matrix.
// A single course can have multiple rows (split across faculty by section).
model CourseSectionAssignment {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  instructorId String
  instructor   User     @relation("SectionInstructor", fields: [instructorId], references: [id])
  sectionCount Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([courseId, instructorId])
  @@index([courseId])
  @@index([instructorId])
}

// OMC-defined equivalence: courses that are the same underlying content
// across different batches/programs (even with different codes/names) and
// can be taught together as one combined class, split into sections once
// combined enrollment crosses the 50-student cap.
model CourseEquivalenceGroup {
  id         String   @id @default(cuid())
  chairmanId String
  chairman   User     @relation("EquivalenceChairman", fields: [chairmanId], references: [id])
  createdById String? // which OMC member created this group
  name       String   // e.g. "Introduction to Programming (shared)"
  createdAt  DateTime @default(now())

  members    CourseEquivalenceMember[]
  sectionAssignments GroupSectionAssignment[]

  @@index([chairmanId])
}

model CourseEquivalenceMember {
  id       String @id @default(cuid())
  groupId  String
  group    CourseEquivalenceGroup @relation(fields: [groupId], references: [id])
  courseId String @unique // a course can only belong to one equivalence group
  course   Course @relation(fields: [courseId], references: [id])

  @@index([groupId])
}

// Faculty section allocation for a combined equivalence group — parallel to
// CourseSectionAssignment but for the group as a whole rather than one course.
model GroupSectionAssignment {
  id           String   @id @default(cuid())
  groupId      String
  group        CourseEquivalenceGroup @relation(fields: [groupId], references: [id])
  instructorId String
  instructor   User     @relation("GroupSectionInstructor", fields: [instructorId], references: [id])
  sectionCount Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([groupId, instructorId])
  @@index([groupId])
  @@index([instructorId])
}

// Dates a Coordinator has declared a holiday — no lecture auto-fills onto these.
model Holiday {
  id            String   @id @default(cuid())
  coordinatorId String
  coordinator   User     @relation("HolidayCoordinator", fields: [coordinatorId], references: [id])
  date          DateTime
  label         String

  @@unique([coordinatorId, date])
  @@index([coordinatorId])
}

// Marks a specific date as Online or On-Campus delivery — shown in delivery reports.
model ClassDayMode {
  id            String   @id @default(cuid())
  coordinatorId String
  coordinator   User     @relation("ClassDayModeCoordinator", fields: [coordinatorId], references: [id])
  date          DateTime
  mode          String   // "Online" | "OnCampus"

  @@unique([coordinatorId, date])
  @@index([coordinatorId])
}

// Continuous Quality Improvement — a record of a finding (from a report, an
// audit, or manual observation) and the action taken in response, tracked
// through to closure. Scoped to whichever batch/course it concerns.
model CqiRecord {
  id            String   @id @default(cuid())
  chairmanId    String
  chairman      User     @relation("CqiChairman", fields: [chairmanId], references: [id])
  authorId      String   // who raised this
  lastUpdatedById String? // who most recently edited status/action
  batchId       String?
  batch         Batch?   @relation(fields: [batchId], references: [id])
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  finding       String   @db.Text
  actionTaken   String?  @db.Text
  status        String   @default("open") // open | in-progress | closed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chairmanId])
  @@index([batchId])
  @@index([courseId])
}

// ===== Indirect PLO Attainment: stakeholder feedback surveys =====
// Alumni and Employers aren't system users — no login, just contact
// records the Coordinator maintains, similar in spirit to Student.
model Alumni {
  id             String   @id @default(cuid())
  coordinatorId  String
  coordinator    User     @relation("AlumniCoordinator", fields: [coordinatorId], references: [id])
  name           String
  email          String?
  degreeProgram  String
  graduationYear Int
  createdAt      DateTime @default(now())

  responses SurveyResponse[]
  @@index([coordinatorId])
}

model Employer {
  id              String   @id @default(cuid())
  coordinatorId   String
  coordinator     User     @relation("EmployerCoordinator", fields: [coordinatorId], references: [id])
  organizationName String
  contactName     String?
  contactEmail    String?
  createdAt       DateTime @default(now())

  responses SurveyResponse[]
  @@index([coordinatorId])
}

model SurveyTemplate {
  id              String   @id @default(cuid())
  coordinatorId   String
  coordinator     User     @relation("SurveyTemplateCoordinator", fields: [coordinatorId], references: [id])
  title           String
  stakeholderType String   // "STUDENT" | "ALUMNI" | "EMPLOYER"
  createdAt       DateTime @default(now())

  questions SurveyQuestion[]
  responses SurveyResponse[]
  @@index([coordinatorId])
}

model SurveyQuestion {
  id               String         @id @default(cuid())
  surveyTemplateId String
  surveyTemplate   SurveyTemplate @relation(fields: [surveyTemplateId], references: [id])
  text             String         @db.Text
  mappedPloId      String?
  mappedPlo        PLO?           @relation(fields: [mappedPloId], references: [id])
  orderIndex       Int            @default(0)

  answers SurveyAnswer[]
  @@index([surveyTemplateId])
}

// One respondent's link into one survey — token-based, no login required.
// respondentId points at whichever stakeholder table matches respondentType.
model SurveyResponse {
  id               String         @id @default(cuid())
  surveyTemplateId String
  surveyTemplate   SurveyTemplate @relation(fields: [surveyTemplateId], references: [id])
  token            String         @unique
  respondentType   String         // "STUDENT" | "ALUMNI" | "EMPLOYER"
  respondentLabel  String         // display name, captured at creation time
  studentId        String?
  student          Student?       @relation(fields: [studentId], references: [id])
  alumniId         String?
  alumni           Alumni?        @relation(fields: [alumniId], references: [id])
  employerId       String?
  employer         Employer?      @relation(fields: [employerId], references: [id])
  submittedAt      DateTime?
  createdAt        DateTime       @default(now())

  answers SurveyAnswer[]
  @@index([surveyTemplateId])
  @@index([token])
}

model SurveyAnswer {
  id               String         @id @default(cuid())
  surveyResponseId String
  surveyResponse   SurveyResponse @relation(fields: [surveyResponseId], references: [id])
  questionId       String
  question         SurveyQuestion @relation(fields: [questionId], references: [id])
  ratingValue      Int            // 1-5

  @@unique([surveyResponseId, questionId])
}

// A real student, imported by the Coordinator per batch (bulk CSV) — the
// foundation for marks entry and result computation.
model Student {
  id         String   @id @default(cuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id])
  name       String
  rollNumber String
  createdAt  DateTime @default(now())

  enrollments StudentEnrollment[]
  marks       StudentMark[]
  transcriptRecords StudentTranscriptRecord[]
  surveyResponses SurveyResponse[]

  @@unique([batchId, rollNumber])
  @@index([batchId])
}

// A student taking a specific course — decoupled from their home batch so a
// repeat/summer enrollment into a different offering still works.
model StudentEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  isRepeat   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

// A student's raw score on one specific assessment instrument (Quiz 1, Midterm
// Q3, etc.) — entered by the Instructor, matching the reference Excel's
// per-item mark sheet.
model StudentMark {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  instrumentId String
  instrument   AssessmentInstrument @relation(fields: [instrumentId], references: [id])
  score        Float
  enteredById  String
  updatedAt    DateTime @updatedAt

  @@unique([studentId, instrumentId])
  @@index([courseId])
  @@index([studentId])
}

// Semester-wide dates for an entire Degree Program — set once by the
// Coordinator, applied automatically to every course currently offered
// under that degree (a course can still override with its own dates if
// it genuinely differs).
model SemesterDates {
  id                 String   @id @default(cuid())
  coordinatorId      String
  coordinator        User     @relation("SemesterDatesCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram      String
  termName           String
  termYear           Int
  semesterStartDate  DateTime?
  midtermStartDate   DateTime?
  midtermEndDate     DateTime?
  finalStartDate     DateTime?
  finalEndDate       DateTime?

  @@unique([coordinatorId, degreeProgram, termName, termYear])
  @@index([coordinatorId])
}

// Singleton — truly platform-wide branding (Lets Innovate + NCEAC), the same
// across every tenant/institution on this SaaS deployment. Set exclusively
// by the Super User. Per-institution branding lives on User (see Chairman's
// instituteName/instituteLogo) since each paying tenant has its own.
model PlatformSettings {
  id            String  @id @default("singleton")
  ownerLogo     String? @db.Text // base64 data URI — "Lets Innovate Pvt Ltd", used for copyright
  nceacLogo     String? @db.Text // base64 data URI — the NCEAC accreditation seal
}

// Program-wide grading scale — which letter grades exist and their GPA
// value, set exclusively by the Program Coordinator. Applies to every
// course they manage.
model GradingScale {
  id            String @id @default(cuid())
  coordinatorId String
  coordinator   User   @relation("GradingScaleCoordinator", fields: [coordinatorId], references: [id])
  letter        String // "A", "A-", "B+", etc.
  gpaValue      Float
  orderIndex    Int    @default(0) // highest grade first

  @@unique([coordinatorId, letter])
  @@index([coordinatorId])
}

// Per-course % cutoff for each letter grade — set by the Instructor
// (starting from the computed mean/SD suggestion), with the Chairman able
// to override for any course under their institution.
model CourseGradeCutoff {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  letter      String
  minPercent  Float
  setById     String   // who last set/changed this (Instructor or Chairman)
  updatedAt   DateTime @updatedAt

  @@unique([courseId, letter])
  @@index([courseId])
}

// A permanent snapshot of a course's section assignments for one specific
// past semester — taken automatically right before a course gets re-offered
// for a new term (which would otherwise overwrite offeredTermName/Year and
// lose the historical record). This is what "download a previous semester's
// assignments" reads from.
// A permanent snapshot of a course's CLO/PLO attainment for one specific
// past offering — taken automatically right before a course gets re-offered
// (which also clears StudentMark/StudentEnrollment for a fresh start, so
// old and new students' marks never mix). This is what "compare this
// offering to a past one" reads from.
// One student's permanent academic record for one course offering — taken
// automatically right before that course's StudentMark/StudentEnrollment
// get cleared on re-offering, so an individual's transcript survives across
// every semester, not just the current one.
model StudentTranscriptRecord {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  coordinatorId String
  courseCode    String
  courseTitle   String
  creditHours   Int
  courseType    String
  termName      String
  termYear      Int
  totalPct      Float
  grade         String
  gpaPoints     Float?
  cloAttainmentJson String @db.Text // JSON: { code, pct, passed }[]
  ploAttainmentJson String @db.Text // JSON: { label, pct, passed }[]
  snapshotAt    DateTime @default(now())

  @@index([studentId])
  @@index([coordinatorId])
}

model AttainmentSnapshot {
  id            String   @id @default(cuid())
  coordinatorId String
  courseLabel   String
  termName      String
  termYear      Int
  studentCount  Int
  cloStatsJson  String   @db.Text // JSON: { code, maxWeight, passCount, failCount }[]
  ploStatsJson  String   @db.Text // JSON: { label, maxWeight, passCount, failCount }[]
  histogramJson String   @db.Text // JSON: { label, count }[]
  snapshotAt    DateTime @default(now())

  @@index([coordinatorId])
}

model AssignmentSnapshot {
  id             String   @id @default(cuid())
  coordinatorId  String
  courseLabel    String
  courseType     String
  batchLabel     String
  termName       String
  termYear       Int
  instructorName String
  sectionCount   Int
  snapshotAt     DateTime @default(now())

  @@index([coordinatorId])
  @@index([termName, termYear])
}

// Chairman-controlled access rules for reports — either role-wide or for a
// specific person, covering view and edit separately (edit only matters for
// reports with embedded actions, like Result Mate's grade cutoffs). No rule
// for a report/subject means the default (today's behavior: open to every
// role that's normally eligible) applies.
model ReportAccessRule {
  id            String  @id @default(cuid())
  chairmanId    String
  chairman      User    @relation("ReportAccessChairman", fields: [chairmanId], references: [id])
  reportId      String  // matches ReportDef.id in lib/reportRegistry.ts
  subjectType   String  // "ROLE" | "USER"
  subjectValue  String  // a role name (e.g. "INSTRUCTOR") or a User.id
  canView       Boolean @default(true)
  canEdit       Boolean @default(true)

  @@unique([chairmanId, reportId, subjectType, subjectValue])
  @@index([chairmanId])
}

// A saved set of reports for one-go printing. Platform-scope bundles (set
// by Super User) are shared across every institution; Coordinator-scope
// bundles are personal to that Coordinator (e.g. "NCEAC Visit Package").
model ReportBundle {
  id          String  @id @default(cuid())
  name        String
  description String?
  scope       String  // "PLATFORM" | "COORDINATOR"
  ownerId     String? // the Coordinator's User.id — null for PLATFORM bundles
  reportIds   String  @db.Text // JSON array of report ids from lib/reportRegistry.ts

  @@index([ownerId])
}

// Program-level narrative content for the full program document (Annex-A
// style) — department intro/vision/mission and PEOs, which nothing else in
// the system tracks. Optional: the document generates fine without it, just
// skipping those sections.
model ProgramProfile {
  id                 String @id @default(cuid())
  coordinatorId      String
  coordinator        User   @relation("ProgramProfileCoordinator", fields: [coordinatorId], references: [id])
  degreeProgram      String
  departmentIntro    String? @db.Text
  departmentVision   String? @db.Text
  departmentMission  String? @db.Text
  peos               String? @db.Text // JSON array of strings

  @@unique([coordinatorId, degreeProgram])
}

model Course {
  id                  String   @id @default(cuid())
  code                String
  title               String
  creditHours         Int
  courseType          String   @default("Core") // Core | Elective | Lab | IDS | General Education | Capstone Project | Field Experience
  hasLab              Boolean  @default(true) // whether this course has a lab component — when false, Lab % is locked to 0 in weight-setting
  semesterNumber      Int?     // 1..8, which semester this is offered in
  coordinatorId       String
  coordinator         User     @relation("CourseCoordinator", fields: [coordinatorId], references: [id])
  batchId             String?  // which cohort/intake this course offering belongs to
  batch               Batch?   @relation(fields: [batchId], references: [id])
  subjectExpertId     String?
  subjectExpert       User?    @relation("CourseSubjectExpert", fields: [subjectExpertId], references: [id])
  instructorId        String?
  instructor          User?    @relation("CourseInstructor", fields: [instructorId], references: [id])
  isOffered           Boolean  @default(false) // whether this course has been activated for its current-semester offering
  offeredTermName     String?  // "Fall" | "Spring" — which term this was offered in, stamped when isOffered becomes true
  offeredTermYear     Int?
  midtermStartDate    DateTime? // set by Coordinator (override) — no lecture auto-fills within this range
  midtermEndDate      DateTime?
  finalStartDate      DateTime?
  finalEndDate        DateTime?
  masterCourseId      String?  // traceability: which HEC/Master course this was adopted from, if any
  masterCourse        MasterCourse? @relation(fields: [masterCourseId], references: [id])
  benchmarkSourceId   String?  // which prior batch's course this template was copied from, if any
  benchmarkSource     Course?  @relation("BenchmarkLineage", fields: [benchmarkSourceId], references: [id])
  benchmarkCopies     Course[] @relation("BenchmarkLineage")
  prerequisiteCourseId String? // the course that should be taken before this one
  prerequisiteCourse  Course?  @relation("PrerequisiteLineage", fields: [prerequisiteCourseId], references: [id])
  postrequisiteCourses Course[] @relation("PrerequisiteLineage")
  createdAt           DateTime @default(now())

  // Gold-standard template fields, set by the Subject Expert
  templateStatus      String   @default("draft") // draft | submitted | approved | changes-requested
  assignmentPct       Int      @default(15)
  quizPct             Int      @default(20)
  projectPct          Int      @default(0)
  labPct              Int      @default(0)
  midtermPct          Int      @default(25)
  finalPct            Int      @default(40)
  omcComment          String?  @db.Text // latest OMC review comment on this template
  templateReviewedById String? // which OMC member last reviewed/approved/rejected this template

  // Extra fields for the Course Description Form / accreditation paperwork
  textbook            String?  @db.Text
  referenceMaterial   String?  @db.Text
  catalogDescription  String?  @db.Text
  programmingAssignmentsNote String? @db.Text
  labInstructorName   String?

  // Instructor's OWN copy of the weights (separate from SE's plan above),
  // populated when the Instructor first opens their delivery page.
  instructorAssignmentPct Int?
  instructorQuizPct       Int?
  instructorProjectPct    Int?
  instructorLabPct        Int?
  instructorMidtermPct    Int?
  instructorFinalPct      Int?

  clos                CLO[]
  lectureRows         LectureRow[]
  ploMappings         CoursePloMapping[]
  weightExceptions    WeightExceptionRequest[]
  assessmentInstruments AssessmentInstrument[]
  sectionAssignments  CourseSectionAssignment[]
  equivalenceMember   CourseEquivalenceMember?
  feedForwardNotes    FeedForwardNote[]
  guidanceComments    InstructorGuidanceComment[]
  cqiRecords          CqiRecord[]
  studentEnrollments  StudentEnrollment[]
  gradeCutoffs        CourseGradeCutoff[]
  studentMarks        StudentMark[]

  @@unique([coordinatorId, batchId, code])
  @@index([coordinatorId])
  @@index([batchId])
}

// Left by an instructor at any point (typically end of semester) for whoever
// teaches this course next — either the next batch's instance of the same
// course, or a course that lists this one as its prerequisite.
model FeedForwardNote {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([courseId])
}

// A running thread between OMC and the Instructor about this specific
// course's delivery — visible throughout the semester, not gated behind a
// submit action.
model InstructorGuidanceComment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  authorId   String
  authorRole String   // "OMC" | "INSTRUCTOR"
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([courseId])
}

// Institutional/Program PLOs — defined by the Program Coordinator (optionally
// starting from a HEC PLO as a template), editable and formally approved by
// the Chairman. CLOs map to THESE, not directly to the read-only HEC list,
// so the institution's actual approved PLOs are what's authoritative.
model PLO {
  id                    String   @id @default(cuid())
  coordinatorId         String
  coordinator           User     @relation("PloCoordinator", fields: [coordinatorId], references: [id])
  batchId               String   // PLOs are scoped per BATCH — even two cohorts of the same degree can differ
  batch                 Batch    @relation("BatchPlos", fields: [batchId], references: [id])
  number                Int
  title                 String
  description           String   @db.Text
  sourceMasterPloNumber Int?     // which HEC PLO this was copied from, if any — traceability only
  status                String   @default("draft") // draft | approved | changes-requested
  chairmanComment       String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  clos                  CLO[]
  ploMappings           CoursePloMapping[]
  surveyQuestions       SurveyQuestion[]

  @@unique([batchId, number])
  @@index([coordinatorId])
  @@index([batchId])
}

// OMC assigns which PLOs each course contributes to — a many-to-many matrix,
// not something a Subject Expert or Coordinator sets themselves.
model CoursePloMapping {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  ploId        String
  plo          PLO      @relation(fields: [ploId], references: [id])
  assignedById String   // the OMC member who made this assignment
  createdAt    DateTime @default(now())

  @@unique([courseId, ploId])
  @@index([courseId])
  @@index([ploId])
}

// CLOs set by the Subject Expert for a course
model CLO {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  source      String   @default("SE") // "SE" | "INSTRUCTOR" — SE's plan vs the Instructor's own delivery copy
  code        String   // "CLO-1"
  statement   String   @db.Text
  bloomLevel  String   // C1..C6
  mappedPloId String?  // references the institution's own PLO (see PLO model)
  mappedPlo   PLO?     @relation(fields: [mappedPloId], references: [id])
  ploContributionPct Int? // this CLO's % contribution toward mappedPlo's attainment —
                          // when several CLOs in the same course map to the same PLO,
                          // their contributions must sum to 100 (enforced at submit time)
  targetPct   Int      @default(60) // NBA/Washington-Accord style: % of students expected to attain this CO — compared against actual attainment on the Program Attainment Analytics dashboard
  createdAt   DateTime @default(now())

  lectureRows LectureRow[]

  @@unique([courseId, source, code])
  @@index([courseId])
}

// The 30-lecture schedule set by the Subject Expert
model LectureRow {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  source        String   @default("SE") // "SE" | "INSTRUCTOR"
  week          Int
  lectureNumber Int
  topic         String
  subtopic      String?
  cloId         String?
  clo           CLO?     @relation(fields: [cloId], references: [id])
  bloomLevel    String?  // C1..C6
  weightPct     Int      @default(0) // auto-computed: sum of linked instruments' marksPct
  actualDate    DateTime? // Instructor-only: the real calendar date this lecture happened
  rescheduledNote String? // set by auto-fill when a holiday/exam date pushed this lecture off its natural weekly slot

  instrumentLinks LectureRowInstrument[]

  @@unique([courseId, source, lectureNumber])
  @@index([courseId])
}

// A specific gradeable item (Quiz 1, Assignment 2, Midterm Q3, Final Q5...)
// worth a defined % of the course's total marks. Lecture rows link to
// whichever instruments test that topic, and their contribution % is the
// sum of those instruments' marksPct — not a manually typed guess.
model AssessmentInstrument {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  source    String   @default("SE") // "SE" | "INSTRUCTOR"
  type      String   // Assignment | Quiz | Midterm | Final | Project | Lab
  label     String   // "Quiz 1", "Midterm Q3"
  marksPct  Int      // this instrument's % of total course marks
  maxScore  Int      @default(10) // the raw marks this instrument is scored out of (e.g. Quiz out of 10)
  createdAt DateTime @default(now())

  lectureLinks LectureRowInstrument[]
  studentMarks StudentMark[]

  @@index([courseId])
}

model LectureRowInstrument {
  id           String   @id @default(cuid())
  lectureRowId String
  lectureRow   LectureRow @relation(fields: [lectureRowId], references: [id])
  instrumentId String
  instrument   AssessmentInstrument @relation(fields: [instrumentId], references: [id])

  @@unique([lectureRowId, instrumentId])
  @@index([lectureRowId])
  @@index([instrumentId])
}

// ============================================================================
// LAYER 1 — OFFICIAL MASTER CURRICULUM
// Seeded from real HEC notifications (see prisma/hec-bscs-2025.ts). Immutable
// once published — institutions adopt a copy via Course.masterCourseId, they
// never edit these rows directly.
// ============================================================================

model MasterCurriculum {
  id                 String   @id @default(cuid())
  authority          String   // "HEC", "NCEAC", etc.
  title              String   // "BS Computer Science"
  version            String   // "2025"
  publicationDate    DateTime?
  sourceReference    String?  // e.g. "HEC/NCRC/CS&IT/2025/8163"
  status             String   @default("PUBLISHED") // DRAFT | PUBLISHED | SUPERSEDED
  createdAt          DateTime @default(now())

  courses            MasterCourse[]
  plos               MasterPLO[]
}

model MasterCourse {
  id                  String   @id @default(cuid())
  masterCurriculumId  String
  masterCurriculum    MasterCurriculum @relation(fields: [masterCurriculumId], references: [id])
  code                String   // suggested numbering — not an official HEC code, see seed file comment
  title               String
  creditHours         Int
  category            String   // General Education | Major | IDS | Certification | Capstone Project | Field Experience
  semesterNumber      Int?

  adoptedInto         Course[]
  seedClos            MasterCourseClo[]
  seedTopics          MasterCourseTopic[]

  @@index([masterCurriculumId])
  @@unique([masterCurriculumId, code])
}

// HEC's stated learning outcomes for a major course — seeded as a starting
// CLO draft when the course is first adopted into a batch.
model MasterCourseClo {
  id             String @id @default(cuid())
  masterCourseId String
  masterCourse   MasterCourse @relation(fields: [masterCourseId], references: [id])
  statement      String @db.Text
  bloomLevel     String // C1..C6, inferred from the outcome's verb
  orderIndex     Int    @default(0)

  @@index([masterCourseId])
}

// A real (or standard-curriculum-synthesized) 32-lecture topic breakdown for
// a major course — seeded as a starting draft on the Lecture Content tab.
model MasterCourseTopic {
  id             String @id @default(cuid())
  masterCourseId String
  masterCourse   MasterCourse @relation(fields: [masterCourseId], references: [id])
  lectureNumber  Int    // 1..32
  topic          String
  subtopic       String?

  @@unique([masterCourseId, lectureNumber])
  @@index([masterCourseId])
}

model MasterPLO {
  id                  String   @id @default(cuid())
  masterCurriculumId  String
  masterCurriculum    MasterCurriculum @relation(fields: [masterCurriculumId], references: [id])
  number              Int
  title               String
  description         String   @db.Text

  @@index([masterCurriculumId])
  @@unique([masterCurriculumId, number])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
}
